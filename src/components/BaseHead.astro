---
import {
    defaultLocale,
    locales,
    ogLocales,
    translatePath,
    useTranslations,
    type Locale,
} from "@/i18n/index";

interface Props {
    locale: Locale;
    title: string;
    description: string;
    /** Imagen de previsualización social; se resuelve a absoluta contra `site`. */
    image?: string;
    /** Para artículos republicados: canonical apuntando fuera. */
    canonicalOverride?: string;
    type?: "website" | "article";
    /**
     * Idiomas en los que esta página existe de verdad. Por defecto, todos.
     *
     * Hace falta porque `hreflang` se calculaba traduciendo la ruta por
     * segmentos, y eso da por hecho que cada página existe en los tres idiomas.
     * No es cierto en dos sitios: un post sólo escrito en inglés no tiene
     * versión en gallego, y la página de enlaces no tiene prefijo de idioma
     * ninguno. Anunciar alternativas que devuelven 404 no es un detalle: Google
     * descarta el grupo entero de idiomas cuando los enlaces de vuelta fallan,
     * así que la etiqueta rota es peor que no ponerla.
     */
    alternateLocales?: readonly Locale[];
}

const {
    locale,
    title,
    description,
    image = "/og-image.png",
    canonicalOverride,
    type = "website",
    alternateLocales = locales,
} = Astro.props;

const t = useTranslations(locale);

const canonical = canonicalOverride ?? new URL(Astro.url.pathname, Astro.site).href;

/*
 * El feed del idioma de esta página, para que los lectores lo encuentren solos.
 *
 * Los tres feeds existían y no los anunciaba nadie: quien pegase la dirección
 * del sitio en un lector no sacaba nada, porque el único enlace estaba dentro
 * del índice del blog. Se anuncia sólo el del idioma que se está leyendo —los
 * tres a la vez sólo sirven para que el lector pregunte cuál—, y con el mismo
 * título que declara el propio feed, para que sea reconocible al suscribirse.
 *
 * La ruta se compone a mano: `localizedPath` cierra con barra, y `/es/rss.xml/`
 * no existe.
 */
const feed = new URL(`/${locale}/rss.xml`, Astro.site).href;
const feedTitle = `${t("blog.title")} — ${t("site.title")}`;
const imageUrl = new URL(image, Astro.site).href;

// Cada página se referencia a sí misma y a sus equivalentes reales. Con una
// sola versión no se anuncia nada: `hreflang` describe variantes de idioma, y
// sin variantes no hay nada que describir.
const alternates =
    alternateLocales.length > 1
        ? alternateLocales.map((code) => ({
              code,
              href: new URL(translatePath(Astro.url.pathname, code), Astro.site).href,
          }))
        : [];
// x-default va al idioma por defecto si esta página existe en él; si no, a la
// primera alternativa, que es la única manera de no dejarlo apuntando a nada.
const defaultHref =
    alternates.find((alt) => alt.code === defaultLocale)?.href ?? alternates[0]?.href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
{defaultHref && <link rel="alternate" hreflang="x-default" href={defaultHref} />}

<link rel="alternate" type="application/rss+xml" title={feedTitle} href={feed} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={ogLocales[locale]} />
<meta property="og:site_name" content="Luis Garbayo Fernández" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{/* El memoji recortado a cuadrado. Se dan las dos medidas en vez de una sola
    imagen grande: a 16 px el navegador reduce por su cuenta y la cara se
    empasta, mientras que un 16 hecho aparte conserva algo de contraste. */}
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" href="/favicon-180.png" />

{/* Las fuentes se sirven desde aquí —ver `scripts/fetch-fonts.mjs`— y sus
    `@font-face` entran con el CSS del sitio. Se precargan sólo los dos ficheros
    latinos, que son los que necesita cualquier página desde el primer pintado:
    el navegador no descubriría que los quiere hasta terminar de leer el CSS, y
    para entonces ya ha perdido un viaje. Los `latin-ext` no se precargan porque
    la mayoría de páginas no llegan a pedirlos. */}
<link
    rel="preload"
    as="font"
    type="font/woff2"
    href="/fonts/space-grotesk-latin.woff2"
    crossorigin
/>
<link
    rel="preload"
    as="font"
    type="font/woff2"
    href="/fonts/jetbrains-mono-latin.woff2"
    crossorigin
/>
