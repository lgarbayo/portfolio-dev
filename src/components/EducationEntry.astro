---
import type { CollectionEntry } from "astro:content";
import { localeTags, useTranslations, type Locale } from "@/i18n/index";

/**
 * Una entrada de Formación.
 *
 * Vive aparte porque la sección la pinta dos veces —titulaciones arriba,
 * certificaciones abajo— y son exactamente la misma ficha. Duplicarla era
 * garantizar que las dos copias acabaran divergiendo.
 */
interface Props {
    locale: Locale;
    entry: CollectionEntry<"education">;
}

const { locale, entry } = Astro.props;
const t = useTranslations(locale);
const { data } = entry;

const formatter = new Intl.DateTimeFormat(localeTags[locale], { year: "numeric" });
const typeLabel = {
    degree: t("education.type.degree"),
    scholarship: t("education.type.scholarship"),
    certification: t("education.type.certification"),
    program: t("education.type.program"),
};
---

<li class="education__item" data-reveal>
    <span class="education__type">{typeLabel[data.type]}</span>
    <h3 class="education__title">{data.title}</h3>
    <p class="education__institution">
        {
            data.url ? (
                <a
                    class="education__link"
                    href={data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {data.institution}
                </a>
            ) : (
                data.institution
            )
        }{" "}
        ·{" "}
        <span class="education__period">
            {formatter.format(data.startDate)}
            {data.endDate ? `–${formatter.format(data.endDate)}` : ""}
        </span>
    </p>

    {data.description.map((paragraph) => <p class="education__description">{paragraph}</p>)}

    {
        data.repoUrl && (
            <a
                class="education__repo"
                href={data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
            >
                {t("projects.viewRepo")} <span aria-hidden="true">→</span>
            </a>
        )
    }

    {/* Las fotos van después del texto y en carga diferida: son el recuerdo de
        lo que se cuenta arriba, no la información. */}
    {
        data.images.length > 0 && (
            <div class="education__gallery" data-education-gallery>
                <div class="education__gallery-viewport" tabindex="0" role="region" aria-label={t("education.gallery.label")}>
                    <div class="education__gallery-track">
                        {[0, 1, 2, 3, 4, 5, 6, 7].map((copy) => (
                            <ul class="education__gallery-list" role="list" aria-hidden={copy > 0 ? "true" : undefined} inert={copy > 0}>
                                {data.images.map((image) => (
                                    <li>
                                        <img
                                            class="education__photo"
                                            src={image.src}
                                            alt={copy === 0 ? image.alt : ""}
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    </li>
                                ))}
                            </ul>
                        ))}
                    </div>
                </div>
            </div>
        )
    }
</li>


<style>
    .education__type {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
        margin-block-end: var(--space-1);
    }

    .education__title {
        font-size: var(--text-lg);
        color: var(--color-text);
    }

    .education__institution {
        margin-block-start: var(--space-1);
        font-size: var(--text-sm);
        color: var(--color-accent);
    }

    /* Igual que en Experiencia: el subrayado sólo al apuntar, para que dentro de
       la línea del centro no compita con la propia titulación. */
    .education__link {
        color: inherit;
        text-decoration: none;
    }

    .education__link:hover,
    .education__link:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .education__period {
        font-family: var(--font-mono);
        color: var(--color-text-subtle);
    }

    .education__description {
        margin-block-start: var(--space-2);
        font-size: var(--text-sm);
        color: var(--color-text-muted);
    }

    .education__repo {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        margin-block-start: var(--space-3);
        font-size: var(--text-sm);
        text-decoration: none;
    }

    .education__repo:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .education__gallery {
        margin-block-start: var(--space-4);
        min-inline-size: 0;
    }

    .education__gallery-viewport {
        overflow-x: auto;
        scrollbar-width: none;
    }

    .education__gallery-track {
        display: flex;
        inline-size: max-content;
        animation: education-gallery-scroll 60s linear infinite;
    }

    .education__gallery-list {
        display: flex;
        flex: 0 0 auto;
        gap: var(--space-3);
        padding: 0;
        padding-inline-end: var(--space-3);
        list-style: none;
    }

    .education__gallery-list > li {
        flex: 0 0 auto;
        inline-size: clamp(15rem, 22vw, 22rem);
    }

    .education__photo {
        display: block;
        inline-size: 100%;
        block-size: clamp(8.5rem, 13vw, 12rem);
        object-fit: contain;
        background: var(--color-surface);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
    }

    @keyframes education-gallery-scroll {
        to { transform: translateX(-12.5%); }
    }

    .education__gallery-viewport:focus-within .education__gallery-track {
        animation-play-state: paused;
    }

    @media (hover: hover) {
        .education__gallery-viewport:hover .education__gallery-track {
            animation-play-state: paused;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .education__gallery-track {
            animation: none;
        }

        .education__gallery-list[aria-hidden="true"] {
            display: none;
        }
    }
</style>
