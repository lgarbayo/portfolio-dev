---
import { localizedPath, useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * Sin canales de contacto: ya están en la página de enlaces, y aquí serían la
 * tercera copia de la misma lista. El pie es para moverse por el sitio y para
 * lo que no cabe en otra parte: el código y el CV.
 */
const SOURCE = "https://github.com/lgarbayo/portfolio-dev";
// El CV del idioma de la página; el gallego no tiene el suyo y va al español.
const CV = locale === "en" ? "/cv-en.pdf" : "/cv-es.pdf";

// Las páginas del sitio, en todas: desde cualquier punto se llega a cualquier
// otro sin pasar por el menú.
const siteMap = [
    { label: t("nav.home"), href: localizedPath(locale) },
    { label: t("nav.blog"), href: localizedPath(locale, "blog") },
    { label: t("links.title"), href: "/links/" },
    { label: "RSS", href: `/${locale}/rss.xml` },
];
---

{/*
  Una sola línea, en mayúsculas pequeñas como la cabecera y la barra de abajo:
  el copyright a un lado; al otro, las páginas del sitio, el código y el CV.
*/}
<footer class="footer">
    <div class="footer__inner">
        <p class="footer__copy">{t("footer.copyright")}</p>
        <nav class="footer__nav" aria-label={t("footer.nav")}>
            {siteMap.map((item) => <a href={item.href}>{item.label}</a>)}
            <a
                href={SOURCE}
                aria-label={t("footer.sourceLabel")}
                data-track="channel_click"
                data-track-channel-name="GitHub"
                data-track-channel-surface="footer"
                target="_blank"
                rel="noopener noreferrer"
            >
                {t("footer.source")} ↗
            </a>
            <a href={CV} target="_blank" rel="noopener noreferrer">{t("cv.title")} ↗</a>
        </nav>
    </div>
</footer>

<style>
    .footer {
        /* Por debajo va la barra fija del contador: se le deja su hueco. */
        padding-block: var(--space-6) calc(var(--hud-height) + var(--space-4));
        font-family: var(--font-pixel);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
    }

    .footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2) var(--space-6);
        padding-inline: var(--gutter);
    }

    .footer__nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-5);
    }

    .footer__nav a {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--tap-target);
        color: var(--color-text-subtle);
        text-decoration: none;
    }

    .footer__nav a:hover {
        color: var(--color-accent-strong);
    }

    @media (max-width: 48rem) {
        .footer__inner {
            flex-direction: column-reverse;
            align-items: flex-start;
        }
    }
</style>
