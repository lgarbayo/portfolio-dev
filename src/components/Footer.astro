---
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * En el pie sólo queda el código fuente.
 *
 * Los cuatro canales de contacto estaban aquí repetidos, y con la página de
 * enlaces del QR pasaban a ser la tercera copia de la misma lista. El sitio
 * donde se pregunta "¿cómo te escribo?" ya existe; el pie es el sitio donde se
 * pregunta "¿cómo está hecho esto?", que es otra cosa.
 */
const SOURCE = "https://github.com/lgarbayo/portfolio-dev";
const GITHUB_ICON = "/assets/ui/github-mark-white.svg";
---

<footer class="footer">
    <div class="footer__inner container">
        <a
            class="footer__source"
            href={SOURCE}
            aria-label={t("footer.sourceLabel")}
            data-track="channel_click"
            data-track-channel-name="GitHub"
            data-track-channel-surface="footer"
            target="_blank"
            rel="noopener noreferrer"
        >
            <span
                class="footer__source-icon"
                aria-hidden="true"
                style={`--icon: url(${GITHUB_ICON})`}
            />
            {t("footer.source")}
        </a>
        <div class="footer__meta">
            <p>{t("footer.copyright")}</p>
            <p class="footer__built">{t("footer.builtWith")}</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        margin-block-start: var(--section-gap);
        border-block-start: 1px solid var(--color-border);
        padding-block: var(--space-6);
        /* Punto de anclaje propio: sin él, con el anclaje obligatorio activo, el
           pie queda pegado al final de la última sección y cuesta llegar. */
        scroll-snap-align: start;
        /* Hueco para que el launcher del juego, anclado abajo a la derecha, no
           se coma ningún enlace del pie. */
        padding-inline-end: 0;
    }

    .footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-5);
    }

    .footer__source {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-block-size: var(--tap-target);
        font-size: var(--text-sm);
        text-decoration: none;
    }

    /* El icono es una máscara sobre el color del texto, no una imagen suelta:
       así sigue al enlace cuando cambia de color. */
    .footer__source-icon {
        inline-size: 1rem;
        block-size: 1rem;
        background-color: currentColor;
        -webkit-mask: var(--icon) center / contain no-repeat;
        mask: var(--icon) center / contain no-repeat;
        opacity: 0.9;
    }

    .footer__meta {
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
        text-align: end;
    }

    .footer__built {
        font-family: var(--font-mono);
    }

    @media (max-width: 48rem) {
        .footer__inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .footer__meta {
            text-align: start;
        }

        /* En móvil medio el launcher sigue fijo en la esquina inferior derecha:
           se reserva sitio para que no solape el último enlace. */
        .footer {
            padding-block-end: var(--space-9);
        }
    }

    @media (max-width: 36rem) {
        .footer {
            padding-block-end: var(--space-6);
        }
    }
</style>
