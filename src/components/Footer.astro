---
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const links = [
    { href: "mailto:lugarbayo@gmail.com", label: t("contact.email"), text: "Email" },
    { href: "https://linkedin.com/in/luis-garbayo", label: t("contact.linkedin"), text: "LinkedIn" },
    { href: "https://github.com/lgarbayo", label: t("contact.github"), text: "GitHub" },
    { href: "https://devpost.com/lgarbayo", label: t("contact.devpost"), text: "Devpost" },
];
---

<footer class="footer">
    <div class="footer__inner container">
        <ul class="footer__links" role="list">
            {
                links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            aria-label={link.label}
                            {...link.href.startsWith("http")
                                ? { target: "_blank", rel: "noopener noreferrer" }
                                : {}}
                        >
                            {link.text}
                        </a>
                    </li>
                ))
            }
        </ul>
        <div class="footer__meta">
            <p>{t("footer.copyright")}</p>
            <p class="footer__built">{t("footer.builtWith")}</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        margin-block-start: var(--section-gap);
        border-block-start: 1px solid var(--color-border);
        padding-block: var(--space-6);
        /* Punto de anclaje propio: sin él, con el anclaje obligatorio activo, el
           pie queda pegado al final de la última sección y cuesta llegar. */
        scroll-snap-align: start;
        /* Hueco para que el launcher del juego, anclado abajo a la derecha, no
           se coma ningún enlace del pie. */
        padding-inline-end: 0;
    }

    .footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-5);
    }

    .footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .footer__links a {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--tap-target);
        font-size: var(--text-sm);
        text-decoration: none;
    }

    .footer__meta {
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
        text-align: end;
    }

    .footer__built {
        font-family: var(--font-mono);
    }

    @media (max-width: 48rem) {
        .footer__inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .footer__meta {
            text-align: start;
        }

        /* En móvil el launcher ocupa la esquina inferior derecha: se reserva
           sitio para que no solape el último enlace. */
        .footer {
            padding-block-end: var(--space-9);
        }
    }
</style>
