---
import { byCurrentThenRecent, getLocalizedEntries, getLocalizedEntry, getPortfolioProjects, hasPublishedPosts } from "@/lib/content";
import { getCollection } from "astro:content";
import { publicAssetExists } from "@/lib/assets";
import { ourenseMapUrl } from "@/lib/profile";
import { pressArticles } from "@/lib/press";
import { localeNames, localeTags, localizedPath, useTranslations, type Locale } from "@/i18n/index";
import "@/styles/game-modals.css";
import { channels } from "@/lib/channels";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * Los paneles que abre el juego al golpear un bloque.
 *
 * Reutiliza las clases del juego original (`.modal-content--about`,
 * `.project-card`, `.experience-item`…) y lee las mismas colecciones que la
 * web. El perfil incluye formación, idiomas y stack; Proyectos incluye las
 * actividades. La selección y el orden de proyectos también son compartidos.
 *
 * Los ids (`aboutModal`, `projectsModal`…) son el contrato con `WorldScene`, que
 * los busca por `${worldId}Modal`.
 */

const about = await getLocalizedEntry("about", locale);
const projects = await getPortfolioProjects(locale);
const experience = (await getLocalizedEntries("experience", locale)).sort(byCurrentThenRecent);
const education = (await getLocalizedEntries("education", locale)).sort(
    (a, b) => a.data.order - b.data.order || b.data.startDate.getTime() - a.data.startDate.getTime(),
);
const languages = await getLocalizedEntry("languages", locale);
const activities = (await getLocalizedEntries("activities", locale)).sort(
    (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);
const stack = await getCollection("stack");
const stackGroups = (["languages", "backend", "frontend", "data", "devops"] as const).map((id) => ({
    label: t(`stack.category.${id}`),
    items: stack.filter((entry) => entry.data.category === id)
        .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name)),
})).filter((group) => group.items.length > 0);
const cvLocales = (["en", "es"] as const).filter((code) => publicAssetExists(`/cv-${code}.pdf`));
const showBlog = await hasPublishedPosts(locale);
const educationYear = new Intl.DateTimeFormat(localeTags[locale], { year: "numeric" });

const formatter = new Intl.DateTimeFormat(localeTags[locale], {
    month: "short",
    year: "numeric",
});
const period = (start: Date, end?: Date) =>
    `${formatter.format(start)} – ${end ? formatter.format(end) : t("experience.present")}`;

const contactChannels = channels.map((channel) => ({
    href: channel.href,
    label: t(channel.label),
    icon: channel.icon,
    alt: channel.name,
}));
---

<div id="aboutModal" class="portfolio-modal">
    <div class="modal-content modal-content--about">
        <button class="modal-close" data-close="aboutModal" aria-label={t("game.close")}>✕</button>
        <h2 class="about-title">{(about?.data.title ?? t("about.title")).toUpperCase()}</h2>
        <p class="about-text">{t("hero.role")}</p>
        <p class="about-text game-location">{t("about.location.prefix")} <a class="game-content-link" href={ourenseMapUrl} target="_blank" rel="noopener noreferrer">Ourense</a>{t("about.location.region")}</p>

        <div class="about-container">
            <div class="about-content">
                {
                    about?.data.blocks.map((block) => (
                        <div class="about-section">
                            {block.title && <h3 class="about-section-title">{block.title}</h3>}
                            <p class="about-text">{block.body}</p>
                        </div>
                    ))
                }
            </div>

            {
                about && (
                    <div class="about-profile">
                        <img
                            src={about.data.profileImage}
                            alt={about.data.profileImageAlt}
                            class="about-profile-image"
                        />
                    </div>
                )
            }
        </div>

        <section class="about-section game-cv">
            <h3 class="about-section-title">{t("cv.title")}</h3>
            {cvLocales.map((code) => <a class="game-content-link" href={`/cv-${code}.pdf`} target="_blank" rel="noopener noreferrer">{localeNames[code]}</a>)}
        </section>

        <section class="about-section game-stack">
            <h3 class="about-section-title">{t("stack.title")}</h3>
            {stackGroups.map((group) => <div class="game-stack-group">
                <h4 class="game-content-title">{group.label}</h4>
                <div class="tech-badges">{group.items.map((entry) => <span class="tech-badge">{entry.data.name}</span>)}</div>
            </div>)}
        </section>

        <section class="about-section game-education">
            <h3 class="about-section-title">{t("education.title")}</h3>
            {education.filter((entry) => entry.data.type !== "certification").map((entry) => <div class="game-education-entry">
                <h4 class="game-content-title">{entry.data.title}</h4>
                <p class="about-text">{entry.data.url
                    ? <a class="game-content-link" href={entry.data.url} target="_blank" rel="noopener noreferrer">{entry.data.institution}</a>
                    : entry.data.institution} · {educationYear.format(entry.data.startDate)}{entry.data.endDate ? `–${educationYear.format(entry.data.endDate)}` : ""}</p>
                {entry.data.description.map((paragraph) => <p class="about-text">{paragraph}</p>)}
                {entry.data.repoUrl && <a class="game-content-link" href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer">{t("projects.viewRepo")} →</a>}
            </div>)}
        </section>

        {languages && <section class="about-section game-languages">
            <h3 class="about-section-title">{t("education.languages.title")}</h3>
            <ul>{languages.data.items.map((item) => <li class="about-text">
                {item.flag && <img class="game-language-flag" src={item.flag} width="30" height="20" alt="" loading="lazy" />}
                <strong>{item.name}</strong> · {item.level}{item.credential && ` · ${item.credential}`}
            </li>)}</ul>
        </section>}

        <section class="about-section game-certifications">
            <h3 class="about-section-title">{t("education.certifications.title")}</h3>
            {education.filter((entry) => entry.data.type === "certification").map((entry) => <div class="game-certification">
                <h4 class="game-content-title">{entry.data.url
                    ? <a class="game-content-link" href={entry.data.url} target="_blank" rel="noopener noreferrer">{entry.data.title}</a>
                    : entry.data.title}</h4>
                <p class="about-text">{entry.data.institution} · {formatter.format(entry.data.startDate)}</p>
            </div>)}
        </section>
    </div>
</div>

<div id="projectsModal" class="portfolio-modal">
    <div class="modal-content modal-content--projects">
        <button class="modal-close" data-close="projectsModal" aria-label={t("game.close")}>✕</button>
        <h2 class="projects-title">{t("projects.title").toUpperCase()}</h2>

        <div class="projects-grid">
            {
                projects.map((project) => (
                            <div class="project-card">
                                <h3>
                                    {project.data.title}
                                </h3>
                                <p class="project-description">{project.data.description}</p>
                                <div class="tech-badges">
                                    {project.data.tags.map((tag) => (
                                        <span class="tech-badge">{tag}</span>
                                    ))}
                                </div>
                                {project.data.highlights.length > 0 && (
                                    <p class="project-features">
                                        {project.data.highlights.join(" • ")}
                                    </p>
                                )}
                                {/*
                                  Cada enlace en su propia línea. En el HTML
                                  original los separaba el salto de línea del
                                  fuente; aquí los nodos quedan pegados y salían
                                  como "GitHub →View on Devpost →".
                                */}
                                {[
                                    project.data.repoUrl && {
                                        href: project.data.repoUrl,
                                        label: t("projects.viewRepo"),
                                    },
                                    project.data.devpostUrl && {
                                        href: project.data.devpostUrl,
                                        label: t("projects.viewDevpost"),
                                    },
                                    project.data.demoUrl && {
                                        href: project.data.demoUrl,
                                        label: t("projects.viewDemo"),
                                    },
                                    project.data.videoUrl && {
                                        href: project.data.videoUrl,
                                        label: t("projects.viewVideo"),
                                    },
                                    project.data.landingUrl && {
                                        href: project.data.landingUrl,
                                        label: t("projects.viewLanding"),
                                    },
                                    project.data.productHuntUrl && {
                                        href: project.data.productHuntUrl,
                                        label: t("projects.viewProductHunt"),
                                    },
                                ]
                                    .filter((link): link is { href: string; label: string } =>
                                        Boolean(link),
                                    )
                                    .map((link) => (
                                        <div>
                                            <a
                                                href={link.href}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="project-link"
                                            >
                                                {link.label} →
                                            </a>
                                        </div>
                                    ))}
                            </div>
                ))
            }
        </div>

        {activities.length > 0 && <section class="game-activities">
            <h3 class="projects-column-title">{t("projects.activities.title")}</h3>
            {activities.map((item) => <div class="project-card game-activity">
                <h3>{item.data.title}</h3>
                <p class="project-description">{item.data.context && `${item.data.context} · `}{formatter.format(item.data.startDate)}{item.data.endDate && ` – ${formatter.format(item.data.endDate)}`}</p>
                {item.data.description && <p class="project-description">{item.data.description}</p>}
                {item.data.award && <p class="project-features">{item.data.award}</p>}
            </div>)}
        </section>}
    </div>
</div>

<div id="experienceModal" class="portfolio-modal">
    <div class="modal-content modal-content--experience">
        <button class="modal-close" data-close="experienceModal" aria-label={t("game.close")}>✕</button>
        <h2 class="experience-title">{t("experience.title").toUpperCase()}</h2>

        {
            experience.map((item) => (
                <div class="experience-item">
                    <div class="experience-header">
                        <h3 class="experience-role">
                            {item.data.role} @ {item.data.url
                                ? <a class="game-content-link" href={item.data.url} target="_blank" rel="noopener noreferrer">{item.data.organization}</a>
                                : item.data.organization}
                        </h3>
                        {item.data.logo && (
                            <img
                                src={item.data.logo}
                                alt={t("experience.logoAlt", { organization: item.data.organization })}
                                class="experience-logo experience-logo--inline"
                                class:list={{ "experience-logo--clinic": item.data.slug === "histora" }}
                            />
                        )}
                    </div>
                    {item.data.startDate && (
                        <p class="experience-period">{period(item.data.startDate, item.data.endDate)}</p>
                    )}
                    {(item.data.employmentType || item.data.location) && (
                        <p class="experience-period">
                            {[item.data.employmentType, item.data.location].filter(Boolean).join(" · ")}
                        </p>
                    )}
                    <ul class="experience-description">
                        {item.data.responsibilities.map((line) => (
                            <li set:html={line} />
                        ))}
                    </ul>
                    {item.data.stack.length > 0 && (
                        <div class="tech-stack">
                            {item.data.stack.map((tech) => (
                                <span class="tech-badge">{tech}</span>
                            ))}
                        </div>
                    )}
                </div>
            ))
        }
    </div>
</div>

<div id="contactModal" class="portfolio-modal">
    <div class="modal-content modal-content--contact">
        <button class="modal-close" data-close="contactModal" aria-label={t("game.close")}>✕</button>
        <h2 class="contact-title">{t("contact.title").toUpperCase()}</h2>
        <p class="contact-description">{t("contact.description")}</p>
        <div class="contact-buttons">
            {
                contactChannels.map((channel) => (
                    <a
                        href={channel.href}
                        class="contact-btn"
                        aria-label={channel.label}
                        {...channel.href.startsWith("http")
                            ? { target: "_blank", rel: "noopener noreferrer" }
                            : {}}
                    >
                        <img src={channel.icon} alt={channel.alt} class="contact-btn__icon" />
                    </a>
                ))
            }
        </div>
        {showBlog && <p class="game-blog-link"><a class="game-content-link" href={localizedPath(locale, "blog/")}>{t("hero.cta.blog")} →</a></p>}
        <section class="game-press game-activities">
            <h3 class="about-section-title">{t("press.title")}</h3>
            {pressArticles.map((article) => <div class="project-card">
                <p class="project-description">{article.publisher} · {formatter.format(new Date(article.published))}</p>
                <a class="game-content-link" href={article.url} lang={article.language} target="_blank" rel="noopener noreferrer">{article.title} ↗</a>
            </div>)}
        </section>
    </div>
</div>
