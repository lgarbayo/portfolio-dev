---
import LanguageSelector from "./LanguageSelector.astro";
import QrButton from "./QrButton.astro";
import { homeSections } from "@/lib/sections";
import { localizedPath, useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
    /** El blog sólo aparece si ese idioma tiene algún post publicado. */
    showBlog?: boolean;
    /** Fuera de la home las anclas necesitan la ruta completa por delante. */
    onHome?: boolean;
    counterpartPaths?: Partial<Record<Locale, string>>;
}

const { locale, showBlog = false, onHome = true, counterpartPaths } = Astro.props;
const t = useTranslations(locale);

const home = localizedPath(locale);
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const sections = homeSections(showBlog).map((section, index) => ({
    ...section,
    number: String(index + 1).padStart(2, "0"),
    label: t(section.label),
}));
const onBlog = Astro.url.pathname.includes("/blog");
---

{/*
  Cabecera: el avatar y el usuario a un lado; al otro, los idiomas, el QR y el
  menú. El menú no ocupa la pantalla: es un desplegable como los de la barra de
  menús de macOS, con la sección actual marcada y su atajo de teclado.
*/}
<header class="header">
    <a class="header__brand" href={anchor("hero")} aria-label="Luis Garbayo">
        <img class="header__avatar" src="/assets/ui/avatar-pixel.png" alt="" width="28" height="28" />
        <span>lgarbayo</span>
    </a>

    <div class="header__actions">
        <div class="header__lang">
            <LanguageSelector locale={locale} counterpartPaths={counterpartPaths} />
        </div>
        <QrButton locale={locale} />
        <button
            class="header__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="primary-nav"
            data-menu-toggle
        >
            <span aria-hidden="true">{t("nav.menu")}</span>
            <span class="header__chevron" aria-hidden="true">⌄</span>
            <span class="visually-hidden" data-menu-label-open={t("nav.menu.open")}
                data-menu-label-close={t("nav.menu.close")}>{t("nav.menu.open")}</span>
        </button>
    </div>
</header>

<nav class="menu" id="primary-nav" aria-label={t("nav.primary")} data-menu>
    <ol class="menu__list" role="list">
        {sections.map((section, index) => (
            <li>
                <a
                    class="menu__item"
                    href={anchor(section.id)}
                    data-nav-section={section.id}
                    data-nav-label={section.label}
                    data-track="nav_click"
                    data-track-nav-target={section.id}
                >
                    <span class="menu__check" aria-hidden="true">✓</span>
                    <span class="menu__label">{section.label}</span>
                    {/* Los números del teclado ya saltan a cada sección
                        (`lib/shortcuts.ts`): el menú lo dice, como en macOS. */}
                    <kbd class="menu__key" aria-hidden="true">{index + 1}</kbd>
                </a>
            </li>
        ))}
    </ol>

    <hr class="menu__sep" />

    <div class="menu__list">
        {showBlog && (
            <a
                class="menu__item"
                href={localizedPath(locale, "blog")}
                data-track="nav_click"
                data-track-nav-target="blog-index"
                {...onBlog ? { "aria-current": "page" } : {}}
            >
                <span class="menu__check" aria-hidden="true">✓</span>
                <span class="menu__label">{t("blog.all")}</span>
            </a>
        )}
        <button class="menu__item" type="button" data-open-game>
            <span class="menu__check" aria-hidden="true"></span>
            <span class="menu__label">{t("game.launcher.label")}</span>
            <kbd class="menu__key" aria-hidden="true">G</kbd>
        </button>
    </div>

    {/* En el móvil los idiomas no caben en la cabecera: bajan aquí. */}
    <div class="menu__lang">
        <hr class="menu__sep" />
        <LanguageSelector locale={locale} counterpartPaths={counterpartPaths} />
    </div>
</nav>

<script>
    import { initHeader } from "@/lib/header";
    initHeader();
    document.addEventListener("astro:page-load", () => initHeader());
</script>

<style>
    .header {
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: var(--z-menu);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        block-size: var(--header-height);
        padding-inline: var(--gutter);
        /* Un degradado y no un fondo: la cabecera no es una barra, es texto
           sobre la pantalla, pero tiene que leerse encima de una foto. */
        background: linear-gradient(to bottom, var(--color-scrim), transparent);
        font-size: var(--text-xs);
        pointer-events: none;
    }

    .header > * {
        pointer-events: auto;
    }

    .header__brand,
    .header__toggle {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-block-size: var(--tap-target);
        color: var(--color-text);
        text-decoration: none;
    }

    .header__brand {
        gap: var(--space-3);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
    }

    .header__avatar {
        inline-size: 28px;
        block-size: 28px;
        border-radius: 50%;
        box-shadow: 0 0 0 0.5px var(--mac-border);
    }

    .header__actions {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
    }

    /* El botón del menú, como uno de la barra de menús: sin borde hasta que se
       pasa por encima o está abierto. */
    .header__toggle {
        gap: var(--space-1);
        padding: 0 var(--space-3);
        background: none;
        border: 0;
        border-radius: 6px;
        font-family: var(--font-system);
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color var(--duration-fast) var(--ease-out);
    }

    .header__toggle:hover,
    .header__toggle[aria-expanded="true"] {
        background: rgba(255, 255, 255, 0.1);
    }

    .header__chevron {
        font-size: 1.1em;
        line-height: 1;
        translate: 0 -0.2em;
        transition: rotate var(--duration-fast) var(--ease-out);
    }

    .header__toggle[aria-expanded="true"] .header__chevron {
        rotate: 180deg;
        translate: 0 0.15em;
    }

    /* --- El menú: un desplegable de macOS --- */

    .menu {
        position: fixed;
        inset-block-start: calc(var(--header-height) - var(--space-2));
        inset-inline-end: var(--gutter);
        z-index: var(--z-menu);
        inline-size: 16.5rem;
        max-block-size: calc(100svh - var(--header-height) - var(--space-4));
        padding: 5px;
        overflow-y: auto;
        background: rgba(40, 40, 42, 0.72);
        border: 0.5px solid var(--mac-border);
        border-radius: 10px;
        box-shadow: var(--mac-highlight), var(--mac-shadow);
        -webkit-backdrop-filter: var(--mac-blur);
        backdrop-filter: var(--mac-blur);
        font-family: var(--font-system);
        font-size: 0.875rem;
        transform-origin: top right;
        /* Cerrado no debe ser alcanzable con Tab: `visibility` lo saca del orden
           de foco, cosa que la opacidad sola no hace. */
        visibility: hidden;
        opacity: 0;
        scale: 0.97;
        transition:
            opacity var(--duration-fast) var(--ease-out),
            scale var(--duration-fast) var(--ease-out),
            visibility var(--duration-fast);
    }

    .menu[data-open] {
        visibility: visible;
        opacity: 1;
        scale: 1;
    }

    .menu__list {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .menu__item {
        display: grid;
        grid-template-columns: 1.1rem minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--space-1);
        inline-size: 100%;
        min-block-size: 1.9rem;
        padding: 0 0.6rem 0 0.35rem;
        background: none;
        border: 0;
        border-radius: 5px;
        color: rgba(255, 255, 255, 0.9);
        font: inherit;
        text-align: start;
        text-decoration: none;
        cursor: default;
    }

    /* El resaltado azul de macOS al pasar por encima o con el teclado. */
    .menu__item:hover,
    .menu__item:focus-visible {
        background: var(--mac-blue);
        color: #fff;
        outline: none;
    }

    .menu__check {
        font-size: 0.8em;
        text-align: center;
        visibility: hidden;
    }

    .menu__item[data-active] .menu__check,
    .menu__item[aria-current] .menu__check {
        visibility: visible;
    }

    .menu__key {
        font-family: var(--font-system);
        font-size: 0.8125rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .menu__item:hover .menu__key,
    .menu__item:focus-visible .menu__key {
        color: rgba(255, 255, 255, 0.75);
    }

    .menu__sep {
        margin: 5px 0.6rem;
        border: 0;
        border-block-start: 0.5px solid rgba(255, 255, 255, 0.14);
    }

    .menu__lang {
        display: none;
    }

    .menu__lang :global(.lang) {
        padding-inline: 0.6rem;
    }

    @media (max-width: 48rem) {
        .header__lang {
            display: none;
        }

        .menu__lang {
            display: block;
        }

        .menu {
            inset-inline: var(--gutter);
            inline-size: auto;
        }

        .menu__item {
            min-block-size: 2.6rem;
            font-size: 1rem;
        }
    }
</style>
