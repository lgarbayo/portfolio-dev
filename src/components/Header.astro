---
import LanguageSelector from "./LanguageSelector.astro";
import QrButton from "./QrButton.astro";
import { homeSections } from "@/lib/sections";
import { localizedPath, useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
    /** El blog sólo aparece si ese idioma tiene algún post publicado. */
    showBlog?: boolean;
    /** Fuera de la home las anclas necesitan la ruta completa por delante. */
    onHome?: boolean;
    counterpartPaths?: Partial<Record<Locale, string>>;
}

const { locale, showBlog = false, onHome = true, counterpartPaths } = Astro.props;
const t = useTranslations(locale);

const home = localizedPath(locale);
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const sections = homeSections(showBlog).map((section, index) => ({
    ...section,
    number: String(index + 1).padStart(2, "0"),
    label: t(section.label),
}));
const onBlog = Astro.url.pathname.includes("/blog");
---

{/*
  Cabecera de pantalla: el nombre a un lado, y al otro el contacto y el menú.
  Va fija y transparente por encima de todo, como el marco de un monitor: la
  navegación ya no vive en la barra sino en el menú a pantalla completa.
*/}
<header class="header">
    <a class="header__brand" href={anchor("hero")}>Luis Garbayo</a>

    <div class="header__actions">
        <a class="header__contact" href={anchor("contact")} data-track="nav_click" data-track-nav-target="contact">
            {t("nav.contact")}
            <span class="header__dot" aria-hidden="true"></span>
        </a>
        <button
            class="header__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="primary-nav"
            data-menu-toggle
        >
            <span aria-hidden="true">{t("nav.menu")}</span>
            <span class="header__bars" aria-hidden="true">≡</span>
            <span class="visually-hidden" data-menu-label-open={t("nav.menu.open")}
                data-menu-label-close={t("nav.menu.close")}>{t("nav.menu.open")}</span>
        </button>
    </div>
</header>

<nav class="menu" id="primary-nav" aria-label={t("nav.primary")} data-menu>
    <ol class="menu__list" role="list">
        {sections.map((section) => (
            <li>
                <a
                    class="menu__link"
                    href={anchor(section.id)}
                    data-nav-section={section.id}
                    data-nav-label={section.label}
                    data-track="nav_click"
                    data-track-nav-target={section.id}
                >
                    <span class="menu__number">{section.number}</span>
                    <span class="menu__label">{section.label}</span>
                </a>
            </li>
        ))}
    </ol>

    <div class="menu__extras">
        <p class="label">{t("nav.menu.extras")}</p>
        <div class="menu__row">
            {showBlog && (
                <a
                    class="menu__extra"
                    href={localizedPath(locale, "blog")}
                    data-track="nav_click"
                    data-track-nav-target="blog-index"
                    {...onBlog ? { "aria-current": "page" } : {}}
                >
                    &gt; {t("blog.all")}
                </a>
            )}
            <button class="menu__extra" type="button" data-open-game>&gt; {t("game.launcher.label")}</button>
            <QrButton locale={locale} />
        </div>
        <LanguageSelector locale={locale} counterpartPaths={counterpartPaths} />
    </div>
</nav>

<script>
    import { initHeader } from "@/lib/header";
    initHeader();
    document.addEventListener("astro:page-load", () => initHeader());
</script>

<style>
    .header {
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: var(--z-menu);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        block-size: var(--header-height);
        padding-inline: var(--gutter);
        /* Un degradado y no un fondo: la cabecera no es una barra, es texto
           sobre la pantalla, pero tiene que leerse encima de una foto. */
        background: linear-gradient(to bottom, rgba(5, 5, 5, 0.85), transparent);
        font-family: var(--font-pixel);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        pointer-events: none;
    }

    .header > * {
        pointer-events: auto;
    }

    .header__brand,
    .header__contact,
    .header__toggle {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-block-size: var(--tap-target);
        color: var(--color-text);
        text-decoration: none;
    }

    .header__brand {
        font-size: var(--text-sm);
    }

    .header__actions {
        display: inline-flex;
        align-items: center;
        gap: var(--space-5);
    }

    .header__contact {
        color: var(--color-text-muted);
    }

    .header__contact:hover {
        color: var(--color-accent-strong);
    }

    .header__dot {
        inline-size: 6px;
        block-size: 6px;
        background: var(--color-live);
        box-shadow: 0 0 8px var(--color-live);
    }

    .header__toggle {
        padding: 0;
        background: none;
        border: 0;
        letter-spacing: inherit;
        text-transform: inherit;
        font: inherit;
        cursor: pointer;
    }

    .header__bars {
        font-size: 1.25em;
        line-height: 1;
    }

    /* --- Menú a pantalla completa --- */

    .menu {
        position: fixed;
        inset: 0;
        z-index: calc(var(--z-menu) - 1);
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
        align-items: center;
        gap: var(--space-8);
        padding: calc(var(--header-height) + var(--space-6)) var(--gutter) calc(var(--hud-height) + var(--space-6));
        background: rgba(5, 5, 5, 0.94);
        backdrop-filter: blur(10px);
        overflow-y: auto;
        overscroll-behavior: contain;
        /* Cerrado no debe ser alcanzable con Tab: `visibility` lo saca del orden
           de foco, cosa que la opacidad sola no hace. */
        visibility: hidden;
        opacity: 0;
        transition:
            opacity var(--duration-base) var(--ease-out),
            visibility var(--duration-base);
    }

    .menu[data-open] {
        visibility: visible;
        opacity: 1;
    }

    .menu__list {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .menu__link {
        display: inline-flex;
        align-items: baseline;
        gap: var(--space-5);
        padding-block: var(--space-1);
        color: var(--color-text-subtle);
        text-decoration: none;
        font-family: var(--font-pixel);
        text-transform: uppercase;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .menu__number {
        font-size: var(--text-sm);
    }

    .menu__label {
        font-size: clamp(2rem, 1.2rem + 3.5vw, 4.25rem);
        line-height: 1.05;
    }

    .menu__link:hover,
    .menu__link:focus-visible,
    .menu__link[data-active] {
        color: var(--color-accent-strong);
    }

    .menu__link[data-active] .menu__number::before {
        content: "▸ ";
    }

    .menu__extras {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        align-self: end;
    }

    .menu__row {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2);
    }

    .menu__extra {
        padding: 0;
        background: none;
        border: 0;
        color: var(--color-text-muted);
        font-family: var(--font-pixel);
        font-size: var(--text-sm);
        text-transform: uppercase;
        text-decoration: none;
        letter-spacing: var(--tracking-wide);
        cursor: pointer;
    }

    .menu__extra:hover,
    .menu__extra[aria-current] {
        color: var(--color-accent-strong);
    }

    @media (max-width: 48rem) {
        .header__contact {
            display: none;
        }

        .menu {
            grid-template-columns: minmax(0, 1fr);
            align-content: start;
            gap: var(--space-7);
        }

        .menu__extras {
            align-self: start;
        }
    }
</style>
