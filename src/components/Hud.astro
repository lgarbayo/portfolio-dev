---
import Kbd from "./Kbd.astro";
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
    /** Fuera de la home no hay secciones que contar: se enseña esto en su lugar. */
    pageLabel?: string;
}

const { locale, pageLabel } = Astro.props;
const t = useTranslations(locale);
---

{/*
  La barra de abajo: en qué sección estás y qué hora es en Madrid. Es la mitad
  inferior del marco de pantalla que empieza en la cabecera. El contador lo
  rellena `hud.ts` a partir del menú; sin JS se queda en la portada, que es
  donde se aterriza.
*/}
<div class="hud" data-hud>
    {/* Contador y hora son decorado para un lector de pantalla: las secciones
        ya tienen sus títulos, y anunciar cada cambio al hacer scroll sería ruido. */}
    <p class="hud__section" aria-hidden="true">
        {pageLabel ? (
            <span class="hud__label">{pageLabel}</span>
        ) : (
            <>
                <span data-hud-index>01</span>
                <span class="hud__total">/ <span data-hud-total>07</span></span>
                <span class="hud__label" data-hud-label>{t("nav.home")}</span>
            </>
        )}
    </p>
    <span class="hud__rule"></span>
    {/* El modo juego vive aquí, en la barra: era un botón flotante en la
        esquina y en este diseño tapaba justo el rótulo de cada ciudad. */}
    <button class="hud__game" type="button" data-open-game aria-label={t("game.launch")}>
        ▸ {t("game.launcher.label")} <Kbd key="G" />
    </button>
    <p class="hud__clock" aria-hidden="true">
        Madrid <time data-hud-clock>--:--</time>
    </p>
</div>

<script>
    import { initHud, destroyHud } from "@/lib/hud";
    initHud();
    document.addEventListener("astro:page-load", initHud);
    document.addEventListener("astro:before-swap", destroyHud);
</script>

<style>
    .hud {
        position: fixed;
        inset-inline: 0;
        inset-block-end: 0;
        z-index: var(--z-sticky);
        display: flex;
        align-items: center;
        gap: var(--space-4);
        block-size: var(--hud-height);
        padding-inline: var(--gutter);
        background: linear-gradient(to top, var(--color-scrim), transparent);
        font-family: var(--font-pixel);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
        pointer-events: none;
    }

    .hud p {
        display: flex;
        gap: var(--space-2);
        white-space: nowrap;
    }

    .hud__label {
        margin-inline-start: var(--space-3);
        color: var(--color-text-muted);
    }

    .hud__game {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-1) 0;
        background: none;
        border: 0;
        color: var(--color-text-muted);
        font: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
        white-space: nowrap;
        cursor: pointer;
        pointer-events: auto;
    }

    .hud__game:hover {
        color: var(--color-accent-strong);
    }

    .hud__rule {
        flex: 1;
        block-size: 1px;
        background: var(--color-border);
    }
    @media (max-width: 48rem) {
        .hud .hud__rule,
        .hud .hud__clock {
            display: none;
        }

        .hud__game {
            margin-inline-start: auto;
        }

        .hud__game :global(.kbd) {
            display: none;
        }
    }

</style>
