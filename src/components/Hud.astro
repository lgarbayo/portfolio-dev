---
import Kbd from "./Kbd.astro";
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
    /** Fuera de la home, la ruta de la página («~/blog/…»). */
    path?: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
---

{/*
  La barra de abajo, como el prompt de una terminal: dónde estás («~/projects
  %») y, al otro lado, el modo juego. En la home la ruta la cambia `hud.ts`
  según la sección que se ve; sin JS se queda en `~`, que es donde se aterriza.
*/}
<div class="hud" data-hud>
    {/* Decorado para un lector de pantalla: las secciones ya tienen sus
        títulos, y anunciar cada cambio al hacer scroll sería ruido. */}
    <p class="hud__prompt" aria-hidden="true">
        <span class="hud__user">luis@garbayo</span>
        <span class="hud__path" data-hud-path>{path ?? "~"}</span>
        <span class="hud__sigil">%</span>
        <span class="hud__cursor"></span>
    </p>
    {/* El modo juego vive aquí, en la barra: era un botón flotante en la
        esquina y tapaba justo el rótulo de cada ciudad. */}
    <button class="hud__game" type="button" data-open-game aria-label={t("game.launch")}>
        ▸ {t("game.launcher.label")} <Kbd key="G" />
    </button>
</div>

<script>
    import { initHud, destroyHud } from "@/lib/hud";
    initHud();
    document.addEventListener("astro:page-load", initHud);
    document.addEventListener("astro:before-swap", destroyHud);
</script>

<style>
    .hud {
        position: fixed;
        inset-inline: 0;
        inset-block-end: 0;
        z-index: var(--z-sticky);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        block-size: var(--hud-height);
        padding-inline: var(--gutter);
        background: linear-gradient(to top, var(--color-scrim), transparent);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
        pointer-events: none;
    }

    .hud__prompt {
        display: flex;
        align-items: center;
        gap: 0.5ch;
        min-inline-size: 0;
        white-space: nowrap;
    }

    .hud__user {
        color: var(--mac-green);
        opacity: 0.8;
    }

    .hud__path {
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--color-text);
    }

    .hud__cursor {
        inline-size: 0.55em;
        block-size: 1.1em;
        background: var(--color-text-muted);
        animation: hud-blink 1.06s steps(1) infinite;
    }

    @keyframes hud-blink {
        50% {
            opacity: 0;
        }
    }

    .hud__game {
        display: inline-flex;
        flex: none;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-1) 0;
        background: none;
        border: 0;
        color: var(--color-text-muted);
        font: inherit;
        white-space: nowrap;
        cursor: pointer;
        pointer-events: auto;
    }

    .hud__game:hover {
        color: var(--color-accent-strong);
    }

    @media (max-width: 48rem) {
        .hud__user {
            display: none;
        }

        .hud__game :global(.kbd) {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hud__cursor {
            animation: none;
        }
    }
</style>
