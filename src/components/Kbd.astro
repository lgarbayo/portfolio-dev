---
interface Props {
    /** La tecla, tal cual se pinta: "G", "Esc", "1". */
    key: string;
}

const { key } = Astro.props;
---

<!--
  Pista de atajo. `aria-hidden` porque es una ayuda visual: el nombre accesible
  del control que acompaña ya dice lo que hace, y leer "G" suelto no aporta.
-->
<kbd class="kbd" aria-hidden="true">{key}</kbd>

<style>
    .kbd {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-inline-size: 1.5em;
        padding: 0.15em 0.4em;
        background: var(--color-surface-raised);
        border: 1px solid var(--color-border-strong);
        border-block-end-width: 2px;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 0.75em;
        line-height: 1;
        color: var(--color-text-subtle);
    }
</style>
