---
/*
 * La capa de la cortina de píxeles: una sola para todo el sitio, la usan tanto
 * las navegaciones entre páginas como los saltos entre secciones (ver
 * `wipe.ts`).
 *
 * La navegación la hace el ClientRouter de Astro y esto sólo se engancha a sus
 * eventos de ciclo de vida: nada de interceptar clics ni de `pushState` propio,
 * que pelearía con el router y rompería el botón atrás.
 */
---
{/* `transition:persist` va aquí, en el elemento, no en el componente: el swap
    del router sustituye el body entero, y sin esto la capa que se anima al
    salir sería un nodo ya desechado cuando toca destaparla — la pantalla se
    quedaría tapada y aparecería la página nueva de golpe. */}
<div class="transition" data-page-transition aria-hidden="true" transition:persist>
    <canvas class="transition__canvas" data-transition-canvas></canvas>
</div>

<style>
    .transition {
        position: fixed;
        inset: 0;
        z-index: var(--z-transition);
        /* Nunca intercepta clics: si una animación se quedase colgada, la página
           de debajo sigue siendo usable. */
        pointer-events: none;
        opacity: 0;
    }

    .transition[data-active] {
        opacity: 1;
    }

    /* Bloques duros: el navegador no debe suavizar el canvas al escalarlo. */
    .transition__canvas {
        display: block;
        image-rendering: pixelated;
    }

    /* La imagen que vuelve tras la cortina: unos fotogramas de temblor y de
       canales de color separados, como un CRT que se enciende. */
    :global(html[data-crt] main),
    :global(html[data-crt] .header),
    :global(html[data-crt] .hud) {
        animation: crt-on 0.42s steps(6, end);
    }

    @keyframes crt-on {
        0% {
            transform: translateX(-3px) scaleY(1.01);
            filter: drop-shadow(3px 0 0 rgba(255, 0, 60, 0.55)) drop-shadow(-3px 0 0 rgba(0, 160, 255, 0.55)) brightness(1.4);
        }
        35% {
            transform: translateX(2px);
            filter: drop-shadow(-2px 0 0 rgba(255, 0, 60, 0.4)) drop-shadow(2px 0 0 rgba(0, 160, 255, 0.4)) brightness(1.15);
        }
        70% {
            transform: translateX(-1px);
            filter: drop-shadow(1px 0 0 rgba(255, 0, 60, 0.25)) drop-shadow(-1px 0 0 rgba(0, 160, 255, 0.25));
        }
        100% {
            transform: none;
            filter: none;
        }
    }

    /* Sin movimiento, la capa no existe: la navegación es un cambio de página
       normal y corriente. */
    @media (prefers-reduced-motion: reduce) {
        .transition {
            display: none;
        }
    }
</style>
