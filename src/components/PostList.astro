---
import type { CollectionEntry } from "astro:content";
import { localeTags, localizedPath, useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
    posts: CollectionEntry<"posts">[];
    emptyMessage: string;
}

const { locale, posts, emptyMessage } = Astro.props;
const t = useTranslations(locale);

const formatter = new Intl.DateTimeFormat(localeTags[locale], {
    day: "numeric",
    month: "long",
    year: "numeric",
});
---

{
    posts.length === 0 ? (
        // Un índice vacío dice que todavía no hay nada, en vez de enseñar una
        // lista vacía que parece un fallo.
        <p class="postlist__empty">{emptyMessage}</p>
    ) : (
        <ul class="postlist" role="list">
            {posts.map((post) => (
                <li class="postlist__item" data-reveal>
                    <div class="postlist__text">
                        <a
                            class="postlist__link"
                            href={localizedPath(post.data.locale, `blog/${post.data.slug}`)}
                        >
                            <time class="postlist__date" datetime={post.data.pubDate.toISOString()}>
                                {formatter.format(post.data.pubDate)}
                            </time>
                            <h2 class="postlist__title">
                                {post.data.title}
                                {post.data.draft && <span class="postlist__draft">{t("blog.draft")}</span>}
                            </h2>
                            <p class="postlist__description">{post.data.description}</p>
                            {post.data.locale !== locale && (
                                <p class="postlist__fallback">{t("content.fallbackNotice")}</p>
                            )}
                        </a>
                        {post.data.tags.length > 0 && (
                            <ul class="postlist__tags" role="list">
                                {post.data.tags.map((tag) => (
                                    <li>
                                        <a class="tag" href={localizedPath(locale, `blog/tag/${tag}`)}>
                                            {tag}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>

                    {/*
                      El clip no se reproduce solo desde el marcado: lo arranca
                      `post-motion`, que respeta el movimiento reducido y sólo
                      toca los que están en pantalla. Sin JS se queda el póster,
                      que es exactamente su primer fotograma.
                    */}
                    {post.data.motion && (
                        <video
                            class="postlist__motion"
                            src={post.data.motion}
                            poster={post.data.motionPoster}
                            aria-label={post.data.motionAlt}
                            muted
                            loop
                            playsinline
                            preload="none"
                            data-post-motion
                        />
                    )}
                </li>
            ))}
        </ul>
    )
}

<style>
    .postlist {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    /* Texto a la izquierda, clip a la derecha. El clip se dimensiona por sí
       mismo y el texto se queda con lo que sobra; `minmax(0, 1fr)` es lo que
       evita que un título largo empuje al clip fuera de la fila. */
    .postlist__item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: var(--space-6);
    }

    .postlist__motion {
        inline-size: clamp(9rem, 20vw, 15rem);
        aspect-ratio: 476 / 346;
        object-fit: cover;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface);
    }

    /* En estrecho el clip pasa debajo del texto y a lo ancho: al lado se
       quedaría en una miniatura ilegible y le robaría sitio al titular. */
    @media (max-width: 48rem) {
        .postlist__item {
            grid-template-columns: 1fr;
        }

        .postlist__motion {
            inline-size: 100%;
            max-inline-size: 20rem;
        }
    }

    .postlist__empty {
        color: var(--color-text-muted);
        font-size: var(--text-lg);
    }

    .postlist__link {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    .postlist__date {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
    }

    .postlist__title {
        margin-block-start: var(--space-2);
        font-size: var(--text-xl);
        color: var(--color-text);
        transition: color var(--duration-fast) var(--ease-out);
    }

    .postlist__link:hover .postlist__title {
        color: var(--color-accent);
    }

    /* El aviso de idioma va con la entrada, no dentro del título: quien lee en
       español tiene que saber antes de entrar que el artículo está en inglés. */
    .postlist__fallback {
        margin-block-start: var(--space-2);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
    }

    .postlist__draft {
        margin-inline-start: var(--space-3);
        padding: var(--space-1) var(--space-2);
        border: 1px dashed var(--color-border-strong);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
        vertical-align: middle;
    }

    .postlist__description {
        margin-block-start: var(--space-2);
        max-inline-size: var(--prose-width);
        color: var(--color-text-muted);
    }

    .postlist__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-block-start: var(--space-3);
        padding: 0;
        list-style: none;
    }

    .postlist__tags a {
        text-decoration: none;
    }
</style>
