---
import type { CollectionEntry } from "astro:content";
import { readingMinutes } from "@/lib/reading-time";
import { localeTags, localizedPath, useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
    posts: CollectionEntry<"posts">[];
    emptyMessage: string;
}

const { locale, posts, emptyMessage } = Astro.props;
const t = useTranslations(locale);

const formatter = new Intl.DateTimeFormat(localeTags[locale], {
    day: "numeric",
    month: "long",
    year: "numeric",
});
---

{
    posts.length === 0 ? (
        // Un índice vacío dice que todavía no hay nada, en vez de enseñar una
        // lista vacía que parece un fallo.
        <p class="postlist__empty">{emptyMessage}</p>
    ) : (
        <ul class="postlist" role="list">
            {posts.map((post) => (
                <li class="postlist__item" data-reveal>
                    <div class="postlist__text">
                        <a
                            class="postlist__link"
                            href={localizedPath(post.data.locale, `blog/${post.data.slug}`)}
                        >
                            <p class="postlist__meta">
                                <time datetime={post.data.pubDate.toISOString()}>
                                    {formatter.format(post.data.pubDate)}
                                </time>
                                <span aria-hidden="true">·</span>
                                <span>
                                    {t("blog.readingTime", {
                                        minutes: readingMinutes(post.body ?? ""),
                                    })}
                                </span>
                            </p>
                            <h2 class="postlist__title">
                                {post.data.title}
                                {post.data.draft && <span class="postlist__draft">{t("blog.draft")}</span>}
                            </h2>
                            <p class="postlist__description">{post.data.description}</p>
                            {post.data.locale !== locale && (
                                <p class="postlist__fallback">{t("content.fallbackNotice")}</p>
                            )}
                        </a>
                        {post.data.tags.length > 0 && (
                            <ul class="postlist__tags" role="list">
                                {post.data.tags.map((tag) => (
                                    <li>
                                        <a class="tag" href={localizedPath(locale, `blog/tag/${tag}`)}>
                                            {tag}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>

                    {/*
                      El clip no se reproduce solo desde el marcado: lo arranca
                      `post-motion`, que respeta el movimiento reducido y sólo
                      toca los que están en pantalla. Sin JS se queda el póster,
                      que es exactamente su primer fotograma.
                    */}
                    {post.data.motion && (
                        <a
                            class="postlist__media-link"
                            href={localizedPath(post.data.locale, `blog/${post.data.slug}`)}
                            aria-label={post.data.title}
                        >
                        <video
                            class="postlist__motion"
                            src={post.data.motion}
                            poster={post.data.motionPoster}
                            aria-label={post.data.motionAlt}
                            muted
                            loop
                            playsinline
                            preload="none"
                            data-post-motion
                        />
                        </a>
                    )}
                </li>
            ))}
        </ul>
    )
}

<style>
    .postlist {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-5);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .postlist__item {
        display: flex;
        flex-direction: column;
        min-inline-size: 0;
        gap: var(--space-5);
        padding: 0.75rem;
        background: var(--color-glass-surface);
        border: 1px solid var(--color-glass-border);
        box-shadow: var(--shadow-glass);
        backdrop-filter: blur(16px) saturate(120%);
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        border-radius: 2rem;
        overflow: hidden;
        transition: translate 180ms ease-out, box-shadow 180ms ease-out, border-color 180ms ease-out;
    }

    .postlist__item:focus-within {
        border-color: color-mix(in srgb, var(--color-text) 35%, var(--color-glass-border));
        box-shadow: var(--shadow-glass), inset 0 0 40px rgba(255, 255, 255, 0.15), 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    @media (hover: hover) and (pointer: fine) {
        .postlist__item:hover {
            translate: 0 -4px;
            border-color: color-mix(in srgb, var(--color-text) 35%, var(--color-glass-border));
            box-shadow: var(--shadow-glass), inset 0 0 40px rgba(255, 255, 255, 0.15), 0 12px 30px rgba(0, 0, 0, 0.12);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .postlist__item { transition: none; }
        .postlist__item:hover { translate: none; }
    }

    .postlist__text {
        padding: 0.5rem 0.75rem 0.75rem;
    }

    .postlist__media-link {
        order: -1;
        display: block;
        border-radius: 1.25rem;
    }

    .postlist__motion {
        display: block;
        inline-size: 100%;
        aspect-ratio: 476 / 346;
        object-fit: cover;
        border-radius: 1.25rem;
        background: var(--color-surface);
    }

    @media (max-width: 48rem) {
        .postlist {
            grid-template-columns: 1fr;
        }

        .postlist__item { border-radius: 1.5rem; padding: 0.5rem; }
        .postlist__motion { border-radius: 1rem; }
    }

    .postlist__empty {
        color: var(--color-text-muted);
        font-size: var(--text-lg);
    }

    .postlist__link {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    /* Fecha y minutos de lectura, en la misma línea: son las dos cosas que
       se miran antes de decidir si se entra. */
    .postlist__meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
    }

    .postlist__title {
        margin-block-start: var(--space-2);
        font-size: var(--text-xl);
        color: var(--color-text);
        transition: color var(--duration-fast) var(--ease-out);
    }

    .postlist__link:hover .postlist__title {
        color: var(--color-accent);
    }

    /* El aviso de idioma va con la entrada, no dentro del título: quien lee en
       español tiene que saber antes de entrar que el artículo está en inglés. */
    .postlist__fallback {
        margin-block-start: var(--space-2);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
    }

    .postlist__draft {
        margin-inline-start: var(--space-3);
        padding: var(--space-1) var(--space-2);
        border: 1px dashed var(--color-border-strong);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
        vertical-align: middle;
    }

    .postlist__description {
        margin-block-start: var(--space-2);
        inline-size: 100%;
        color: var(--color-text-muted);
    }

    .postlist__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-block-start: var(--space-3);
        padding: 0;
        list-style: none;
    }

    .postlist__tags a {
        text-decoration: none;
    }
</style>
