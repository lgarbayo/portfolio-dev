---
import { useTranslations, type Locale } from "@/i18n/index";
import type { CollectionEntry } from "astro:content";

interface Props {
    locale: Locale;
    project: CollectionEntry<"projects">;
    isFallback?: boolean;
}

const { locale, project, isFallback = false } = Astro.props;
const t = useTranslations(locale);
const data = project.data;

const links = [
    data.demoUrl && { href: data.demoUrl, label: t("projects.viewDemo"), kind: "demo" },
    data.videoUrl && { href: data.videoUrl, label: t("projects.viewVideo"), kind: "video" },
    data.landingUrl && { href: data.landingUrl, label: t("projects.viewLanding"), kind: "landing" },
    data.devpostUrl && { href: data.devpostUrl, label: t("projects.viewDevpost"), kind: "devpost" },
    data.productHuntUrl && {
        href: data.productHuntUrl,
        label: t("projects.viewProductHunt"),
        kind: "producthunt",
    },
    data.repoUrl && { href: data.repoUrl, label: t("projects.viewRepo"), kind: "repo" },
].filter((link): link is { href: string; label: string; kind: string } => Boolean(link));
---

<article class="card" data-reveal>
    {
        data.thumbnail && (
            <div class:list={["card__media", { "card__media--warehouse": data.slug === "warehouse" }]}>
                <img
                    class="card__thumb"
                    class:list={{
                        "card__thumb--contain": ["pepon-bot", "taiafox"].includes(data.slug),
                    }}
                    src={data.thumbnail}
                    alt={data.thumbnailAlt!}
                    width={data.slug === "warehouse" ? 1600 : 640}
                    height={data.slug === "warehouse" ? 1097 : 360}
                    loading="lazy"
                    decoding="async"
                />
            </div>
        )
    }

    <div class="card__body">
        <h3 class="card__title">{data.title}</h3>
        <p class="card__description">{data.description}</p>

        {
            links.length > 0 && (
                <div class="card__links">
                    {links.map((link) => (
                        <a
                            class="card__link"
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            data-track="project_link_click"
                            data-track-project-slug={data.slug}
                            data-track-link-kind={link.kind}
                        >
                            {link.label} <span aria-hidden="true">↗</span>
                        </a>
                    ))}
                </div>
            )
        }

        {isFallback && <p class="card__fallback">{t("content.fallbackNotice")}</p>}
    </div>
</article>

<style>
    .card {
        display: flex;
        flex-direction: column;
        padding: 0.75rem;
        background: var(--color-glass-surface);
        border: 1px solid var(--color-glass-border);
        box-shadow: var(--shadow-glass);
        backdrop-filter: blur(16px) saturate(120%);
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        border-radius: 2rem;
        overflow: hidden;
        min-inline-size: 0;
        transition: translate 180ms ease-out, box-shadow 180ms ease-out, border-color 180ms ease-out;
    }

    .card:focus-within {
        border-color: color-mix(in srgb, var(--color-text) 35%, var(--color-glass-border));
        box-shadow: var(--shadow-glass), inset 0 0 40px rgba(255, 255, 255, 0.15), 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    @media (hover: hover) and (pointer: fine) {
        .card:hover {
            translate: 0 -4px;
            border-color: color-mix(in srgb, var(--color-text) 35%, var(--color-glass-border));
            box-shadow: var(--shadow-glass), inset 0 0 40px rgba(255, 255, 255, 0.15), 0 12px 30px rgba(0, 0, 0, 0.12);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .card { transition: none; }
        .card:hover { translate: none; }
    }

    .card__media {
        overflow: hidden;
        border-radius: 1.25rem;
    }

    .card__media--warehouse {
        position: relative;
        aspect-ratio: 1424 / 920;
    }

    /* Encadra la ventana del simulador, eliminando el margen de la captura. */
    .card__media--warehouse .card__thumb {
        position: absolute;
        inset-inline-start: -6.18%;
        inset-block-start: -7.39%;
        inline-size: 112.36%;
        max-inline-size: none;
        aspect-ratio: auto;
        border-radius: 0;
    }

    .card__thumb {
        display: block;
        inline-size: 100%;
        block-size: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 1.25rem;
        background: color-mix(in srgb, var(--color-bg) 50%, transparent);
    }

    .card__body {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: start;
        padding: 1.25rem 0.75rem 0.5rem;
        gap: 0.875rem;
    }

    .card__thumb--contain {
        object-fit: contain;
    }

    .card__title {
        font-family: var(--font-sans);
        font-size: clamp(1.35rem, 1rem + 0.7vw, 1.8rem);
        font-weight: var(--weight-semibold);
        letter-spacing: -0.035em;
        line-height: 1.2;
        color: var(--color-text);
    }

    .card__description {
        inline-size: 100%;
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        line-height: 1.65;
    }

    .card__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-block-start: auto;
        padding-block-start: 0.75rem;
    }

    .card__link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-block-size: var(--tap-target);
        color: var(--color-text);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        text-decoration: none;
    }

    .card__link:hover,
    .card__link:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .card__fallback {
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
    }

    @media (max-width: 48rem) {
        .card {
            border-radius: 1.5rem;
            padding: 0.5rem;
        }

        .card__media,
        .card__thumb {
            border-radius: 1rem;
        }

        .card__body {
            padding: 1rem 0.5rem 0.25rem;
        }
    }
</style>

<style is:global>
    .tag {
        padding: var(--space-1) var(--space-3);
        background: var(--color-accent-dim);
        border: 1px solid var(--color-accent-border);
        border-radius: var(--radius-sm);
        color: var(--color-accent);
        font-size: var(--text-xs);
        font-weight: var(--weight-medium);
        white-space: nowrap;
    }
</style>
