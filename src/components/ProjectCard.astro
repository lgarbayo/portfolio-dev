---
import { useTranslations, type Locale } from "@/i18n/index";
import type { CollectionEntry } from "astro:content";

interface Props {
    locale: Locale;
    project: CollectionEntry<"projects">;
    isFallback?: boolean;
}

const { locale, project, isFallback = false } = Astro.props;
const t = useTranslations(locale);
const data = project.data;

// Sólo se pintan los enlaces que existen: una tarjeta no debe mostrar controles
// muertos por un campo opcional que nadie rellenó.
const links = [
    data.repoUrl && { href: data.repoUrl, label: t("projects.viewRepo") },
    data.demoUrl && { href: data.demoUrl, label: t("projects.viewDemo") },
    data.devpostUrl && { href: data.devpostUrl, label: t("projects.viewDevpost") },
].filter((link): link is { href: string; label: string } => Boolean(link));
---

<article class="card" data-reveal>
    {
        data.thumbnail && (
            <img
                class="card__thumb"
                src={data.thumbnail}
                alt={data.thumbnailAlt!}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
            />
        )
    }

    <header class="card__head">
        <h3 class="card__title">{data.title}</h3>
        {
            (data.context || data.year) && (
                <p class="card__context">
                    {[data.context, data.year].filter(Boolean).join(" · ")}
                </p>
            )
        }
    </header>

    <p class="card__description">{data.description}</p>

    {data.impact && <p class="card__impact">{data.impact}</p>}

    {
        data.tags.length > 0 && (
            <ul class="card__tags scroll-x" role="list">
                {data.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                ))}
            </ul>
        )
    }

    {
        data.highlights.length > 0 && (
            <p class="card__highlights">{data.highlights.join(" • ")}</p>
        )
    }

    {
        links.length > 0 && (
            <div class="card__links">
                {links.map((link) => (
                    <a
                        class="card__link"
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {link.label} <span aria-hidden="true">→</span>
                    </a>
                ))}
            </div>
        )
    }

    {isFallback && <p class="card__fallback">{t("content.fallbackNotice")}</p>}
</article>

<style>
    .card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding: var(--space-5);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-inline-start: 3px solid var(--color-accent);
        border-radius: var(--radius-md);
        block-size: 100%;
    }

    .card[hidden] {
        display: none;
    }

    .card__thumb {
        inline-size: 100%;
        block-size: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: var(--radius-sm);
    }

    .card__title {
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        color: var(--color-accent);
    }

    .card__context {
        margin-block-start: var(--space-1);
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        color: var(--color-text-subtle);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
    }

    .card__description {
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
    }

    .card__impact {
        font-size: var(--text-sm);
        color: var(--color-text);
        font-weight: var(--weight-medium);
    }

    .card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .card__highlights {
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
        font-style: italic;
    }

    .card__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        margin-block-start: auto;
        padding-block-start: var(--space-2);
    }

    .card__link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        min-block-size: var(--tap-target);
        font-size: var(--text-sm);
        font-weight: var(--weight-semibold);
        text-decoration: none;
    }

    .card__fallback {
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
    }
</style>

<style is:global>
    .tag {
        padding: var(--space-1) var(--space-3);
        background: var(--color-accent-dim);
        border: 1px solid var(--color-accent-border);
        border-radius: var(--radius-sm);
        color: var(--color-accent);
        font-size: var(--text-xs);
        font-weight: var(--weight-medium);
        white-space: nowrap;
    }
</style>
