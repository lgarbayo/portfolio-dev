---
import { sectionNumber } from "@/lib/sections";

interface Props {
    id: string;
    title?: string;
    description?: string;
    /** Las secciones se revelan al entrar en viewport; el hero no, ya está ahí. */
    reveal?: boolean;
    /** Si la home enseña el blog: cambia el número de las que van detrás. */
    showBlog?: boolean;
}

const { id, title, description, reveal = true, showBlog = true } = Astro.props;
const number = sectionNumber(id, showBlog);
---

<section class="section" id={id} aria-labelledby={title ? `${id}-title` : undefined}>
    <div class="container">
        {
            title && (
                <header class="section__head" {...reveal ? { "data-reveal": "" } : {}}>
                    <p class="label">{number}</p>
                    <h2 class="section__title" id={`${id}-title`}>
                        {title}
                    </h2>
                    {description && <p class="section__description label">{description}</p>}
                </header>
            )
        }
        <slot />
    </div>
</section>

<style>
    .section {
        /* Cada sección ocupa al menos una pantalla, con su contenido centrado
           entre la cabecera y la barra de abajo. */
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-block-size: 100svh;
        padding-block: calc(var(--header-height) + var(--space-6)) calc(var(--hud-height) + var(--space-6));
    }

    .section__head {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: baseline;
        column-gap: var(--space-3);
        margin-block-end: var(--space-6);
        padding-block-end: var(--space-3);
        border-block-end: 1px solid var(--color-border);
    }

    .section > .container {
        inline-size: calc(100% - var(--gutter) * 2);
    }

    .section__title {
        font-size: var(--text-2xl);
        color: var(--color-accent-strong);
    }

    .section__description {
        grid-column: 1 / -1;
        margin-block-start: var(--space-2);
        max-inline-size: var(--prose-width);
        text-transform: none;
        letter-spacing: 0;
        font-family: var(--font-mono);
    }
</style>
