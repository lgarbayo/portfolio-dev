---
import { useTranslations, type Locale } from "@/i18n/index";

/**
 * Ficha de detalle: un `<dialog>` nativo con forma de ventana de macOS. El
 * botón rojo del semáforo cierra, como en una ventana de verdad; Escape también.
 *
 * Los paneles de la home enseñan una línea por entrada; el detalle —tareas,
 * fotos, enlaces— vive aquí. El `<dialog>` modal da gratis lo difícil: el foco
 * atrapado dentro, Escape para cerrar y el resto de la página inerte. Se abre
 * con cualquier botón `data-sheet-open="<id>"` (ver `lib/sheets.ts`).
 */
interface Props {
    id: string;
    locale: Locale;
    title: string;
    /** Línea pequeña sobre el título: tipo, periodo… */
    kicker?: string;
}

const { id, locale, title, kicker } = Astro.props;
const t = useTranslations(locale);
---

<dialog class="sheet" id={id} aria-labelledby={`${id}-title`}>
    <div class="sheet__frame mac-window">
        <div class="mac-titlebar">
            <span class="mac-lights">
                <button class="sheet__close" type="button" data-sheet-close aria-label={`${t("overview.close")} (Esc)`}>
                    <span aria-hidden="true">×</span>
                </button>
                <i aria-hidden="true"></i>
                <i aria-hidden="true"></i>
            </span>
            <span class="mac-title" aria-hidden="true">{title}</span>
        </div>
        <header class="sheet__head">
            {kicker && <p class="label">{kicker}</p>}
            <h3 class="sheet__title" id={`${id}-title`}>{title}</h3>
        </header>
        <div class="sheet__body">
            <slot />
        </div>
    </div>
</dialog>

<style>
    .sheet {
        /* El reset global quita los márgenes, y son los que centran un
           `<dialog>` modal: sin esto se abre pegado arriba a la izquierda. */
        margin: auto;
        inline-size: min(100% - 2rem, 46rem);
        max-block-size: min(100% - 4rem, 52rem);
        padding: 0;
        color: var(--color-text);
        /* El marco lo pone la ventana de dentro: el `<dialog>` es transparente. */
        background: none;
        border: 0;
        overflow: visible;
    }

    .sheet::backdrop {
        background: rgba(0, 0, 0, 0.72);
        backdrop-filter: blur(4px);
    }

    .sheet[open] {
        animation: sheet-in var(--duration-base) var(--ease-out);
    }

    @keyframes sheet-in {
        from {
            opacity: 0;
            scale: 0.96;
        }
    }

    .sheet__frame {
        max-block-size: min(100svh - 4rem, 52rem);
        background: rgba(28, 28, 30, 0.92);
    }

    .sheet__head {
        padding: var(--space-5) var(--space-5) var(--space-4);
        border-block-end: 0.5px solid var(--color-border);
    }

    .sheet__title {
        margin-block-start: var(--space-2);
        font-family: var(--font-pixel);
        font-size: var(--text-lg);
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
    }

    /* El rojo del semáforo. La × sólo aparece al pasar por encima, como en
       macOS; el área táctil es más grande que el punto. */
    .sheet__close {
        position: relative;
        display: grid;
        place-items: center;
        cursor: pointer;
    }

    .sheet__close::before {
        content: "";
        position: absolute;
        inset: -10px;
    }

    .sheet__close span {
        font-family: var(--font-system);
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
        color: rgba(0, 0, 0, 0.6);
        opacity: 0;
    }

    .sheet__close:hover span,
    .sheet__close:focus-visible span {
        opacity: 1;
    }

    .sheet__body {
        min-block-size: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: var(--space-5);
        overflow-y: auto;
        line-height: var(--leading-normal);
    }

    .sheet__body :global(ul) {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding-inline-start: 1.1rem;
    }

    .sheet__body :global(li::marker) {
        content: "› ";
        color: var(--color-text-subtle);
    }

    .sheet__body :global(.sheet__gallery) {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
        gap: var(--space-3);
    }

    .sheet__body :global(.sheet__gallery img) {
        inline-size: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border: 1px solid var(--color-border);
    }

    .sheet__body :global(.sheet__tags) {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        padding: 0;
        list-style: none;
    }

    .sheet__body :global(.sheet__tags li) {
        padding: 0.15rem 0.5rem;
        border: 1px solid var(--color-border-strong);
        font-size: var(--text-xs);
    }

    .sheet__body :global(.sheet__tags li::marker) {
        content: none;
    }

    .sheet__body :global(.sheet__link) {
        font-family: var(--font-pixel);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        text-decoration: none;
    }
</style>
