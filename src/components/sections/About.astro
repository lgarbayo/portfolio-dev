---
import Section from "../Section.astro";
import CvViewer from "../CvViewer.astro";
import { getLocalizedEntry } from "@/lib/content";
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const about = await getLocalizedEntry("about", locale);
const ourenseMapUrl = "https://www.google.com/maps/place/Ourense,+Orense,+Ourense/@41.7115912,-20.5173476,3632696m/data=!3m1!1e3!4m2!3m1!1s0xd2ffeb5bc5378eb:0x295326a374bca39c";
---

<Section id="about" title={about?.data.title ?? t("about.title")}>
    <div class="about">
        <div class="about__content">
            <p class="about__location">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                </svg>
                <span>{t("about.location.prefix")} <a href={ourenseMapUrl} target="_blank" rel="noopener noreferrer">Ourense</a>{t("about.location.region")}</span>
            </p>
            {
                about?.data.blocks.map((block) => (
                    <article class="about__block" data-reveal>
                        <h3 class="about__block-title">{block.title}</h3>
                        <p class="about__text">{block.body}</p>
                    </article>
                ))
            }

            <CvViewer locale={locale} />
        </div>

        {
            about && (
                <figure class="about__figure" data-reveal>
                    <img
                        class="about__image"
                        src={about.data.profileImage}
                        alt={about.data.profileImageAlt}
                        width="420"
                        height="520"
                        loading="lazy"
                        decoding="async"
                    />
                </figure>
            )
        }
    </div>

</Section>

<style>
    .about {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        gap: var(--space-7);
        align-items: start;
    }

    .about__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .about__content :global(.cv) {
        margin-block-start: 0;
    }

    .about__location {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-text-muted);
        font-size: var(--text-sm);
    }

    .about__location span {
        min-inline-size: 0;
    }

    .about__location svg {
        flex-shrink: 0;
    }

    .about__location a {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .about__block-title {
        font-size: var(--text-lg);
        color: var(--color-text);
        margin-block-end: var(--space-2);
    }

    .about__text {
        color: var(--color-text-muted);
        line-height: var(--leading-relaxed);
    }

    .about__figure {
        margin: 0;
        inline-size: min(100%, 22rem);
        justify-self: end;
        position: sticky;
        inset-block-start: var(--space-8);
    }

    .about__image {
        inline-size: 100%;
        block-size: auto;
        border-radius: var(--radius-lg);
        border: 1px solid var(--color-border);
        object-fit: cover;
    }

    @media (max-width: 56rem) {
        .about {
            grid-template-columns: minmax(0, 1fr);
        }

        .about__figure {
            position: static;
            max-inline-size: 18rem;
            justify-self: start;
        }
    }
</style>
