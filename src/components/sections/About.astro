---
import Section from "../Section.astro";
import { getLocalizedEntry } from "@/lib/content";
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const about = await getLocalizedEntry("about", locale);
---

<Section id="about" title={about?.data.title ?? t("about.title")}>
    <div class="about">
        <div class="about__content">
            {
                about?.data.blocks.map((block) => (
                    <article class="about__block" data-reveal>
                        <h3 class="about__block-title">{block.title}</h3>
                        <p class="about__text">{block.body}</p>
                    </article>
                ))
            }
        </div>

        {
            about && (
                <figure class="about__figure" data-reveal>
                    <img
                        class="about__image"
                        src={about.data.profileImage}
                        alt={about.data.profileImageAlt}
                        width="420"
                        height="520"
                        loading="lazy"
                        decoding="async"
                    />
                </figure>
            )
        }
    </div>
</Section>

<style>
    .about {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        gap: var(--space-7);
        align-items: start;
    }

    .about__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        max-inline-size: var(--prose-width);
    }

    .about__block-title {
        font-size: var(--text-lg);
        color: var(--color-text);
        margin-block-end: var(--space-2);
    }

    .about__text {
        color: var(--color-text-muted);
        line-height: var(--leading-relaxed);
    }

    .about__figure {
        margin: 0;
        position: sticky;
        inset-block-start: var(--space-8);
    }

    .about__image {
        inline-size: 100%;
        block-size: auto;
        border-radius: var(--radius-lg);
        border: 1px solid var(--color-border);
        object-fit: cover;
    }

    @media (max-width: 56rem) {
        .about {
            grid-template-columns: minmax(0, 1fr);
        }

        .about__figure {
            position: static;
            max-inline-size: 18rem;
        }
    }
</style>
