---
import Section from "../Section.astro";
import CvViewer from "../CvViewer.astro";
import { getLocalizedEntry } from "@/lib/content";
import { ourenseMapUrl } from "@/lib/profile";
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const about = await getLocalizedEntry("about", locale);
---

<Section id="about">
    <article class="about" aria-labelledby="about-title" data-reveal>
        <div class="about__content">
            <h2 class="about__title" id="about-title">{about?.data.title ?? t("about.title")}</h2>
            <p class="about__location">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                </svg>
                <span>{t("about.location.prefix")} <a href={ourenseMapUrl} target="_blank" rel="noopener noreferrer">Ourense</a>{t("about.location.region")}</span>
            </p>
            {
                about?.data.blocks.map((block) => (
                    <div class="about__block">
                        {block.title && <h3 class="about__block-title">{block.title}</h3>}
                        <p class="about__text">{block.body}</p>
                    </div>
                ))
            }

            <CvViewer locale={locale} />
        </div>

        {
            about && (
                <figure class="about__figure">
                    <img
                        class="about__image"
                        src={about.data.profileImage}
                        alt={about.data.profileImageAlt}
                        width="1200"
                        height="1600"
                        loading="lazy"
                        decoding="async"
                    />
                </figure>
            )
        }
        <picture class="about__sticker" aria-hidden="true">
            <source media="(prefers-reduced-motion: reduce)" srcset="/assets/ui/spider-man-still.webp" />
            <img src="/assets/ui/spider-man.gif" alt="" width="480" height="480" loading="lazy" decoding="async" />
        </picture>
    </article>

</Section>

<style>
    .about {
        --about-photo-width: 22rem;
        --about-padding: clamp(1.25rem, 3vw, 3rem);
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, var(--about-photo-width));
        gap: var(--space-7);
        align-items: center;
        padding: var(--about-padding);
        background: var(--color-glass-surface);
        border: 1px solid var(--color-glass-border);
        border-radius: 2rem;
        box-shadow: var(--shadow-glass);
        backdrop-filter: blur(16px) saturate(120%);
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        overflow: hidden;
    }

    .about__title {
        font-family: var(--font-mono);
        font-size: var(--text-2xl);
        color: var(--color-accent);
    }

    .about__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .about__content :global(.cv) {
        margin-block-start: 0;
    }

    .about__location {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-text-muted);
        font-size: var(--text-sm);
    }

    .about__location span {
        min-inline-size: 0;
    }

    .about__location svg {
        flex-shrink: 0;
    }

    .about__location a {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .about__block-title {
        font-size: var(--text-lg);
        color: var(--color-text);
        margin-block-end: var(--space-2);
    }

    .about__text {
        color: var(--color-text-muted);
        line-height: var(--leading-relaxed);
    }

    .about__figure {
        margin: 0;
        inline-size: 100%;
        justify-self: end;
    }

    .about__image {
        inline-size: 100%;
        block-size: auto;
        border-radius: 1.25rem;
        object-fit: cover;
    }

    .about__sticker {
        position: absolute;
        inset-block-end: -1px;
        inset-inline-end: calc(var(--about-padding) + var(--about-photo-width) + var(--space-4));
        inline-size: clamp(10rem, 14vw, 14rem);
        pointer-events: none;
    }

    .about__sticker img {
        inline-size: 100%;
        block-size: auto;
    }

    @media (max-width: 56rem) {
        .about {
            grid-template-columns: minmax(0, 1fr);
            border-radius: 1.5rem;
        }

        .about__figure {
            inline-size: calc(100% - 4rem);
            max-inline-size: 20rem;
            justify-self: center;
        }

        .about__content :global(.cv__list) {
            justify-content: center;
        }

        .about__content :global(.cv__title) {
            text-align: center;
        }

        .about__sticker {
            inset-inline-start: auto;
            inset-inline-end: 0.25rem;
            inline-size: 7.5rem;
        }
    }
</style>
