---
import Section from "../Section.astro";
import EducationEntry from "../EducationEntry.astro";
import { getLocalizedEntries, getLocalizedEntry } from "@/lib/content";
import { localeTags, useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const entries = (await getLocalizedEntries("education", locale)).sort(
    (a, b) =>
        a.data.order - b.data.order || b.data.startDate.getTime() - a.data.startDate.getTime(),
);

/*
 * Las certificaciones van en su propio bloque, no mezcladas con las
 * titulaciones: son otra cosa y se leen de otra manera. El tipo de cada entrada
 * es lo que decide dónde cae, así que añadir una certificación es crear su
 * fichero, sin tocar esto.
 */
const education = entries.filter((entry) => entry.data.type !== "certification");
const certifications = entries.filter((entry) => entry.data.type === "certification");

const languages = await getLocalizedEntry("languages", locale);

// Mes y año para las credenciales. Con sólo el año, veinte certificados del
// mismo curso se leen como si fueran simultáneos.
const issued = new Intl.DateTimeFormat(localeTags[locale], { month: "short", year: "numeric" });
---

<Section id="education" title={t("education.title")}>
    <ul class="education__list" role="list">
        {education.map((entry) => <EducationEntry locale={locale} entry={entry} />)}
    </ul>

    {
        languages && (
            <div class="education__block" data-reveal>
                <h3 class="education__block-title">{t("education.languages.title")}</h3>
                <ul class="education__languages" role="list">
                    {languages.data.items.map((item) => (
                        <li class="education__language">
                            <span class="education__language-heading">
                                {item.flag && <img class="education__language-flag" src={item.flag} alt="" width="40" height="28" loading="lazy" />}
                                <span class="education__language-name">{item.name}</span>
                            </span>
                            <span class="education__language-level">
                                {item.level}
                                {item.credential && (
                                    <span class="education__credential">· {item.credential}</span>
                                )}
                            </span>
                        </li>
                    ))}
                </ul>
            </div>
        )
    }

    {/*
        Las certificaciones van en formato corto —nombre, entidad y fecha—, no
        como las titulaciones. Son veintitantas: con la ficha completa de arriba
        ocuparían media página cada una y enterrarían los dos grados. El bloque
        tampoco existe hasta que haya alguna, que un titular sobre una lista
        vacía se lee como algo roto.
    */}
    {
        certifications.length > 0 && (
            <div class="education__block education__certifications">
                <h3 class="education__block-title" data-reveal>
                    {t("education.certifications.title")}
                </h3>
                <ul class="education__certs" role="list">
                    {certifications.map((entry) => (
                        <li class="education__cert" data-reveal>
                            <p class="education__cert-title">
                                {entry.data.url ? (
                                    <a
                                        class="education__link"
                                        href={entry.data.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {entry.data.title}
                                    </a>
                                ) : (
                                    entry.data.title
                                )}
                            </p>
                            <p class="education__cert-meta">
                                {entry.data.institution} ·{" "}
                                <span class="education__period">
                                    {issued.format(entry.data.startDate)}
                                </span>
                            </p>
                        </li>
                    ))}
                </ul>
            </div>
        )
    }
</Section>

<style>
    .education__list {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .education__block {
        margin-block-start: var(--space-7);
    }

    .education__block-title {
        margin-block-end: var(--space-4);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
    }

    .education__languages {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .education__language {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: var(--space-2);
        font-size: var(--text-sm);
        padding: var(--space-5);
        border-radius: 1.25rem;
    }

    .education__language,
    .education__certifications {
        background: var(--color-glass-surface);
        border: 1px solid var(--color-glass-border);
        box-shadow: var(--shadow-glass);
        backdrop-filter: blur(16px) saturate(120%);
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        transition: translate 180ms ease-out, box-shadow 180ms ease-out, border-color 180ms ease-out;
    }

    :is(.education__language, .education__certifications):focus-within {
        border-color: color-mix(in srgb, var(--color-text) 35%, var(--color-glass-border));
        box-shadow: var(--shadow-glass), inset 0 0 40px rgba(255, 255, 255, 0.15), 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    @media (hover: hover) and (pointer: fine) {
        :is(.education__language, .education__certifications):hover {
            translate: 0 -4px;
            border-color: color-mix(in srgb, var(--color-text) 35%, var(--color-glass-border));
            box-shadow: var(--shadow-glass), inset 0 0 40px rgba(255, 255, 255, 0.15), 0 12px 30px rgba(0, 0, 0, 0.12);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :is(.education__language, .education__certifications) { transition: none; }
        :is(.education__language, .education__certifications):hover { translate: none; }
    }

    .education__certifications {
        padding: clamp(1.25rem, 3vw, 2.5rem);
        border-radius: 2rem;
    }

    .education__certifications .education__block-title {
        color: var(--color-text);
    }

    .education__language-name {
        font-size: var(--text-lg);
        font-weight: var(--weight-medium);
        color: var(--color-text);
    }

    .education__language-heading {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .education__language-flag {
        inline-size: 2.5rem;
        block-size: 1.75rem;
        object-fit: contain;
        flex-shrink: 0;
        filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.15));
    }

    .education__language-level {
        color: var(--color-text-muted);
    }

    /*
     * Dos columnas mientras quepan. Veintitantas credenciales en una sola
     * columna son una pared de texto; en dos, se recorren de un vistazo.
     */
    .education__certs {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
        gap: var(--space-4) var(--space-6);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .education__cert-title {
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        color: var(--color-text);
    }

    .education__cert {
        padding-block: var(--space-3);
        border-block-end: 1px solid var(--color-border);
    }

    .education__cert-meta {
        margin-block-start: var(--space-1);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }

    .education__link {
        color: inherit;
        text-decoration: none;
    }

    .education__link:hover,
    .education__link:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .education__period {
        font-family: var(--font-mono);
        color: var(--color-text-subtle);
    }

    .education__credential {
        margin-inline-start: var(--space-2);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
    }
</style>
