---
import { getLocalizedEntry } from "@/lib/content";
import { publicAssetExists } from "@/lib/assets";
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const hero = await getLocalizedEntry("hero", locale);

/*
 * La figura del centro: un render fijo en el HTML y el modelo 3D encima cuando
 * el navegador puede con él.
 *
 * El render es el que manda para que la bienvenida esté completa desde el primer
 * pintado; el modelo lo sustituye después y añade el giro hacia el cursor. Cada
 * uno entra si su fichero existe, así que quitar el GLB deja la web entera.
 */
const FIGURE_POSTER = "/assets/ui/personaje.webp";
const FIGURE_MODEL = "/assets/ui/personaje.glb";
const poster = publicAssetExists(FIGURE_POSTER) ? FIGURE_POSTER : null;
const model = publicAssetExists(FIGURE_MODEL) ? FIGURE_MODEL : null;

/*
 * Las fichas que flotan alrededor, una por sección.
 *
 * `x` e `y` son su sitio en el escenario, en porcentaje. Están todas fuera de la
 * banda central —del 35% al 65%— porque ahí es donde viven el saludo y la
 * figura, y una ficha encima la taparía.
 *
 * `float` y `delay` los desincronizan: con el mismo periodo las seis subirían y
 * bajarían a la vez, y eso no flota, late.
 */
const tiles = [
    { id: "about", label: t("nav.about"), x: 20, y: 26, float: 7.5, delay: -0.5 },
    { id: "projects", label: t("nav.projects"), x: 79, y: 19, float: 8.5, delay: -2.5 },
    { id: "stack", label: t("nav.stack"), x: 11, y: 58, float: 6.5, delay: -4 },
    { id: "experience", label: t("nav.experience"), x: 87, y: 54, float: 9, delay: -1.5 },
    { id: "education", label: t("nav.education"), x: 25, y: 84, float: 7, delay: -3 },
    { id: "contact", label: t("nav.contact"), x: 73, y: 86, float: 8, delay: -5.5 },
] as const;
---

<section class="hero" id="hero">
    <div class="hero__stage">
        <div class="hero__center">
            <h1 class="hero__greeting">{hero?.data.greeting ?? t("hero.greeting")}</h1>
            <div class="hero__figure" data-avatar-slot {...model ? { "data-model": model } : {}}>
                {
                    poster && (
                        <img
                            class="hero__figure-poster"
                            src={poster}
                            alt=""
                            width="439"
                            height="900"
                            fetchpriority="high"
                        />
                    )
                }
            </div>
        </div>

        <ul class="hero__tiles" role="list">
            {
                tiles.map((tile) => (
                    <li
                        class="hero__tile"
                        style={`--x:${tile.x}%; --y:${tile.y}%; --float:${tile.float}s; --delay:${tile.delay}s`}
                    >
                        <a class="hero__tile-link" href={`#${tile.id}`}>
                            <span class="hero__tile-icon" aria-hidden="true">
                                {tile.id === "about" && (
                                    <svg viewBox="0 0 24 24" focusable="false">
                                        <circle cx="12" cy="8.5" r="3.5" />
                                        <path d="M4.8 20a7.2 7.2 0 0 1 14.4 0" />
                                    </svg>
                                )}
                                {tile.id === "projects" && (
                                    <svg viewBox="0 0 24 24" focusable="false">
                                        <path d="M3 6.8h5.6l2 2.6H21v9a1.6 1.6 0 0 1-1.6 1.6H4.6A1.6 1.6 0 0 1 3 18.4z" />
                                    </svg>
                                )}
                                {tile.id === "stack" && (
                                    <svg viewBox="0 0 24 24" focusable="false">
                                        <path d="m12 3 9 5-9 5-9-5z" />
                                        <path d="m3 13.5 9 5 9-5" />
                                    </svg>
                                )}
                                {tile.id === "experience" && (
                                    <svg viewBox="0 0 24 24" focusable="false">
                                        <rect x="3" y="7.5" width="18" height="12" rx="1.6" />
                                        <path d="M9 7.5V6a1.6 1.6 0 0 1 1.6-1.6h2.8A1.6 1.6 0 0 1 15 6v1.5" />
                                    </svg>
                                )}
                                {tile.id === "education" && (
                                    <svg viewBox="0 0 24 24" focusable="false">
                                        <path d="M12 4 2.5 9 12 14l9.5-5z" />
                                        <path d="M6.5 11.4V16c0 1.6 2.5 2.9 5.5 2.9s5.5-1.3 5.5-2.9v-4.6" />
                                    </svg>
                                )}
                                {tile.id === "contact" && (
                                    <svg viewBox="0 0 24 24" focusable="false">
                                        <rect x="3" y="5.5" width="18" height="13" rx="1.6" />
                                        <path d="m3.6 7 8.4 6 8.4-6" />
                                    </svg>
                                )}
                            </span>
                            <span class="hero__tile-label">{tile.label}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>

    {/*
      Aviso sólo para pantallas estrechas: ahí no se monta la figura 3D ni el
      teclado de Stack, y quien llegue desde el móvil no tiene manera de saber
      que se está perdiendo la mitad de la gracia. En escritorio no se pinta.
    */}
    <p class="hero__desktop-note">{t("hero.desktopNote")}</p>
</section>

<style>
    .hero {
        /* Primera pantalla completa, y sólo la bienvenida: lo de debajo se ve al
           hacer scroll, no asomando por el borde. */
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-block-size: calc(100svh - var(--header-height));
        padding-block: var(--space-6);
        scroll-snap-align: start;
    }

    /*
     * El escenario es el sistema de referencia de las fichas: van colocadas en
     * porcentaje sobre él, así que su reparto se mantiene igual en cualquier
     * pantalla en vez de depender de píxeles.
     */
    .hero__stage {
        position: relative;
        inline-size: min(100% - var(--gutter) * 2, 68rem);
        margin-inline: auto;
        block-size: 100%;
        min-block-size: min(42rem, calc(100svh - var(--header-height) - var(--space-8)));
        /* Un halo tenue detrás del centro: separa la figura del fondo plano sin
           tener que meter una caja ni un borde. */
        background: radial-gradient(
            ellipse 55% 45% at 50% 52%,
            rgba(255, 255, 255, 0.05),
            transparent 70%
        );
    }

    .hero__center {
        position: absolute;
        inset-block-start: 50%;
        inset-inline-start: 50%;
        translate: -50% -50%;
        inline-size: min(100%, 30rem);
        text-align: center;
    }

    .hero__greeting {
        font-size: var(--text-2xl);
        font-weight: var(--weight-medium);
        color: var(--color-accent);
    }

    .hero__figure {
        position: relative;
        margin-block-start: var(--space-4);
        /* La caja manda sobre lo que lleve dentro: así el render y el modelo
           ocupan exactamente lo mismo y el cambio de uno a otro no mueve nada. */
        block-size: clamp(260px, 46vh, 460px);
        display: flex;
        justify-content: center;
    }

    .hero__figure-poster {
        block-size: 100%;
        inline-size: auto;
        max-inline-size: 100%;
        object-fit: contain;
        /* Sombra proyectada: apoya la figura en la página en vez de dejarla
           flotando sobre el fondo plano. */
        filter: drop-shadow(0 22px 30px rgba(0, 0, 0, 0.5));
        transition: opacity var(--duration-slow) var(--ease-out);
    }

    /* El render se retira sólo cuando hay modelo que lo sustituya, y con un
       fundido: el encuadre de los dos es parecido pero no idéntico, y un corte
       seco lo delata. */
    .hero__figure[data-avatar-live] .hero__figure-poster {
        opacity: 0;
    }

    /* El lienzo de Three ocupa la caja entera, debajo del render mientras éste
       se desvanece. */
    .hero__figure :global(canvas) {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
    }

    .hero__tiles {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .hero__tile {
        position: absolute;
        inset-block-start: var(--y);
        inset-inline-start: var(--x);
        translate: -50% -50%;
        animation: hero-float var(--float) var(--ease-in-out, ease-in-out) var(--delay) infinite;
    }

    /* Sube y baja, y de paso se ladea un poco: sólo vertical parece un ascensor. */
    @keyframes hero-float {
        0%,
        100% {
            transform: translateY(-6px) rotate(-1.5deg);
        }
        50% {
            transform: translateY(6px) rotate(1.5deg);
        }
    }

    .hero__tile-link {
        display: grid;
        place-items: center;
        inline-size: clamp(3.25rem, 4.5vw, 4.25rem);
        aspect-ratio: 1;
        border: 1px solid var(--color-border-strong);
        border-radius: var(--radius-lg);
        background: var(--color-surface-raised);
        color: var(--color-text);
        text-decoration: none;
        box-shadow: 0 0 0 rgba(255, 255, 255, 0);
        transition:
            box-shadow var(--duration-base) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out),
            scale var(--duration-fast) var(--ease-out);
    }

    .hero__tile-link:hover,
    .hero__tile-link:focus-visible {
        border-color: var(--color-accent-border);
        color: var(--color-accent);
        scale: 1.08;
        /* El resplandor de la referencia, en gris: es lo que hace que la ficha
           parezca encenderse en vez de sólo cambiar de borde. */
        box-shadow: 0 0 28px rgba(255, 255, 255, 0.22);
    }

    .hero__tile-icon svg {
        inline-size: 1.6rem;
        block-size: 1.6rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* El nombre de la sección aparece al apuntar o al recibir foco. Existe
       siempre en el DOM: es el nombre accesible del enlace. */
    .hero__tile-label {
        position: absolute;
        inset-block-start: calc(100% + var(--space-2));
        inset-inline-start: 50%;
        translate: -50%;
        white-space: nowrap;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        opacity: 0;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    .hero__tile-link:hover .hero__tile-label,
    .hero__tile-link:focus-visible .hero__tile-label {
        opacity: 1;
    }

    .hero__desktop-note {
        display: none;
        margin-block-start: var(--space-6);
        margin-inline: auto;
        max-inline-size: 36ch;
        text-align: center;
        text-wrap: balance;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: var(--leading-relaxed);
        color: var(--color-text-subtle);
    }

    /*
     * La condición es la misma que usa `avatar.ts` para no montar la figura:
     * pantalla estrecha o puntero grueso. Así el aviso aparece exactamente
     * cuando hay algo que avisar, y no en un portátil con la ventana a medias.
     */
    @media (max-width: 56rem), (pointer: coarse) {
        .hero__desktop-note {
            display: block;
        }
    }

    /*
     * En pantalla estrecha no hay sitio para repartir seis fichas alrededor de
     * la cara sin taparla: dejan de flotar sueltas y pasan a una fila debajo.
     */
    @media (max-width: 48rem) {
        .hero__stage {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: var(--space-6);
            min-block-size: 0;
        }

        .hero__center {
            position: static;
            translate: none;
        }

        .hero__tiles {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: var(--space-4) var(--space-5);
        }

        .hero__tile {
            position: static;
            translate: none;
            animation: none;
        }

        /* Sin hover que valga, el nombre va siempre visible y dentro de la
           ficha: colgando por debajo se chocaba con el de la ficha vecina. */
        .hero__tile-label {
            position: static;
            translate: none;
            opacity: 1;
        }

        .hero__tile-link {
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
            inline-size: auto;
            min-inline-size: 5.5rem;
            aspect-ratio: auto;
            padding: var(--space-3) var(--space-2);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero__tile {
            animation: none;
        }
    }
</style>

<style is:global>
    /* Los botones se comparten entre secciones; viven en global para no
       duplicar la misma regla en cinco componentes. */
    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        min-block-size: var(--tap-target);
        padding-inline: var(--space-5);
        border: 1px solid var(--color-border-strong);
        border-radius: var(--radius-full);
        background: transparent;
        color: var(--color-text);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        text-decoration: none;
        cursor: pointer;
        transition:
            border-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out),
            background-color var(--duration-fast) var(--ease-out);
    }

    .button:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }

    .button--primary {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: var(--color-bg);
        font-weight: var(--weight-semibold);
    }

    .button--primary:hover {
        background: var(--color-accent-bright);
        border-color: var(--color-accent-bright);
        color: var(--color-bg);
    }

    .button--ghost {
        border-style: dashed;
        color: var(--color-text-muted);
        font-family: var(--font-mono);
    }
</style>
