---
import { byCurrentThenRecent, getLocalizedEntries } from "@/lib/content";
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * A la derecha, lo que estoy haciendo ahora: el puesto en curso más reciente y
 * la titulación que sigue abierta. Salen del contenido, no del marcado, para
 * que el hero no se quede contando un trabajo que ya terminó.
 */
const now = new Date();
const currentJob = (await getLocalizedEntries("experience", locale))
    .filter((entry) => entry.data.startDate && !entry.data.endDate && entry.data.order === 0)
    .sort(byCurrentThenRecent)[0];
const currentDegree = (await getLocalizedEntries("education", locale)).find(
    (entry) => entry.data.type === "degree" && (!entry.data.endDate || entry.data.endDate > now),
);

const lines = [
    currentJob &&
        t("hero.roleAt", { role: currentJob.data.role, organization: currentJob.data.organization }),
    currentDegree && `${currentDegree.data.title}, ${currentDegree.data.institution}.`,
].filter((line): line is string => Boolean(line));

const STATIC = "/assets/ui/hero-portrait.webp";
const VOXELS = "/assets/ui/portrait-voxels.png";
---

<section class="hero" id="hero" aria-labelledby="hero-title">
    {/*
      El retrato: la imagen fija va en el HTML y la escena de cubos la sustituye
      en escritorio (`hero-portrait.ts`). La imagen es la misma malla dibujada
      plana, así que el cambio no se nota más que en que empieza a moverse.
    */}
    <div class="hero__portrait" data-hero-portrait data-voxels={VOXELS}>
        <img
            class="hero__portrait-still"
            src={STATIC}
            alt={t("hero.portraitAlt")}
            width="1056"
            height="1260"
            fetchpriority="high"
            decoding="async"
        />
    </div>

    <div class="hero__intro">
        <h1 class="hero__name" id="hero-title">Luis Garbayo</h1>
        <p class="hero__meta label">
            <span>// {t("hero.role")}</span>
            <span>{t("hero.location")}</span>
        </p>
    </div>

    {lines.length > 0 && (
        <div class="hero__now">
            <p class="label">{t("hero.currently")}</p>
            {lines.map((line) => <p class="hero__now-line">{line}</p>)}
        </div>
    )}

    <a class="hero__scroll label" href="#about" aria-hidden="true" tabindex="-1">{t("hero.scroll")} ↓</a>
</section>

<script>
    import { initHeroPortrait, destroyHeroPortrait } from "@/lib/hero-portrait";
    // Después del primer pintado: el retrato fijo ya está, la escena puede
    // esperar a que el navegador respire.
    const start = () => {
        const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
        idle(() => void initHeroPortrait());
    };
    start();
    document.addEventListener("astro:page-load", start);
    document.addEventListener("astro:before-swap", destroyHeroPortrait);
</script>

<style>
    .hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: center;
        min-block-size: 100svh;
        padding-inline: var(--gutter);
        padding-block: var(--header-height) var(--hud-height);
        overflow: hidden;
        isolation: isolate;
    }

    .hero__portrait {
        position: absolute;
        inset-block: var(--header-height) 0;
        inset-inline: 0;
        z-index: -1;
        display: flex;
        justify-content: center;
        align-items: flex-end;
    }

    .hero__portrait :global(canvas) {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
    }

    .hero__portrait-still {
        block-size: 92%;
        inline-size: auto;
        max-inline-size: 100%;
        object-fit: contain;
        object-position: bottom;
        /* Se funde con el negro por abajo, igual que la escena. */
        mask-image: linear-gradient(to top, transparent, #000 18%);
        transition: opacity var(--duration-slow) var(--ease-out);
    }

    .hero__portrait[data-live] .hero__portrait-still {
        opacity: 0;
    }

    .hero__intro {
        align-self: center;
        text-shadow: 0 2px 18px rgba(0, 0, 0, 0.8);
    }

    .hero__name {
        font-size: clamp(2.25rem, 1.4rem + 3.2vw, 4.25rem);
        line-height: 1;
        color: var(--color-accent-strong);
    }

    .hero__meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-6);
        margin-block-start: var(--space-3);
    }

    .hero__now {
        justify-self: end;
        max-inline-size: 22rem;
        text-align: end;
        text-shadow: 0 2px 18px rgba(0, 0, 0, 0.8);
    }

    .hero__now-line {
        margin-block-start: var(--space-2);
        font-family: var(--font-pixel);
        font-size: var(--text-sm);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--color-text);
    }

    .hero__scroll {
        position: absolute;
        inset-block-end: calc(var(--hud-height) + var(--space-3));
        inset-inline-start: 50%;
        translate: -50% 0;
        text-decoration: none;
        animation: hero-blink 2.4s steps(2, jump-none) infinite;
    }

    @keyframes hero-blink {
        50% {
            opacity: 0.35;
        }
    }

    /* En estrecho, como en un móvil de verdad: nombre arriba, retrato en medio
       y lo de ahora abajo, cada cosa en su franja. */
    @media (max-width: 48rem) {
        .hero {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: auto 1fr auto;
            align-items: start;
            padding-block: calc(var(--header-height) + var(--space-4)) calc(var(--hud-height) + var(--space-4));
        }

        .hero__portrait {
            inset-block: 22% 12%;
        }

        .hero__now {
            grid-row: 3;
            justify-self: end;
        }

        .hero__scroll {
            display: none;
        }
    }
</style>
