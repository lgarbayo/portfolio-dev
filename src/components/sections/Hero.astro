---
import { byCurrentThenRecent, getLocalizedEntries } from "@/lib/content";
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * Lo que estoy haciendo ahora: el puesto en curso más reciente y la titulación
 * que sigue abierta. Salen del contenido, no del marcado, para que el hero no
 * se quede contando un trabajo que ya terminó.
 */
const now = new Date();
const currentJob = (await getLocalizedEntries("experience", locale))
    .filter((entry) => entry.data.startDate && !entry.data.endDate && entry.data.order === 0)
    .sort(byCurrentThenRecent)[0];
const currentDegree = (await getLocalizedEntries("education", locale)).find(
    (entry) => entry.data.type === "degree" && (!entry.data.endDate || entry.data.endDate > now),
);

const lines = [
    currentJob &&
        t("hero.roleAt", {
            role: currentJob.data.role,
            organization: currentJob.data.displayName ?? currentJob.data.organization,
        }),
    currentDegree && `${currentDegree.data.title}, ${currentDegree.data.institution}.`,
].filter((line): line is string => Boolean(line));

const PROMPT = "luis@garbayo ~ %";
// Tamaño de `portrait.webp`: lo escribe `scripts/portrait/make_portrait.py`.
import portraitMeta from "../../../public/assets/ui/portrait.json";
const PORTRAIT_WIDTH = portraitMeta.width;
const PORTRAIT_HEIGHT = portraitMeta.height;
---

<section class="hero" id="hero" aria-labelledby="hero-title">
    {/*
      Una ventana de Terminal de macOS: el nombre, el rol y lo de ahora salen
      como la respuesta a tres órdenes. El texto está entero en el HTML; la
      animación de escribir es `hero-terminal.ts`.
    */}
    <div class="hero__terminal mac-window" data-terminal>
        <div class="mac-titlebar">
            <span class="mac-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="mac-title">luis — -zsh — 80×24</span>
        </div>
        <div class="term">
            <p class="term__line" data-step aria-hidden="true">
                <span class="term__prompt">{PROMPT}</span> <span data-type="whoami">whoami</span>
            </p>
            <h1 class="term__name" id="hero-title" data-step>Luis Garbayo</h1>

            <p class="term__line" data-step aria-hidden="true">
                <span class="term__prompt">{PROMPT}</span> <span data-type="cat role.txt">cat role.txt</span>
            </p>
            <p class="term__out" data-step>
                {t("hero.role")} <span class="term__dim">·</span> {t("hero.location")}
            </p>

            {lines.length > 0 && (
                <>
                    <p class="term__line" data-step aria-hidden="true">
                        <span class="term__prompt">{PROMPT}</span> <span data-type="cat now.md">cat now.md</span>
                    </p>
                    {lines.map((line) => (
                        <p class="term__out term__now" data-step>
                            <span class="term__arrow" aria-hidden="true">→</span> {line}
                        </p>
                    ))}
                </>
            )}

            <p class="term__line" data-step aria-hidden="true" data-cursor-home>
                <span class="term__prompt">{PROMPT}</span> <span class="term__cursor" data-cursor></span>
            </p>
        </div>
    </div>
    {/* Antes del primer pintado: si toca animar, se esconden los pasos aquí y no
        en el módulo, que llega tarde y dejaría ver el texto un instante. */}
    <script is:inline>
        (function () {
            try {
                if (sessionStorage.getItem("hero-typed")) return;
                if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                document.querySelector("[data-terminal]").setAttribute("data-typing", "");
            } catch (e) {}
        })();
    </script>

    {/*
      El retrato: la foto recortada a color. Encima la anima un shader
      (`hero-portrait.ts`); sin JS, sin WebGL o con movimiento reducido se queda
      esta misma foto, fija.
    */}
    <div class="hero__portrait" data-hero-portrait>
        <img
            class="hero__portrait-still"
            src="/assets/ui/portrait.webp"
            alt={t("hero.portraitAlt")}
            width={PORTRAIT_WIDTH}
            height={PORTRAIT_HEIGHT}
            fetchpriority="high"
            decoding="async"
        />
    </div>
    {/* Si va a haber escena, la foto fija se esconde hasta que la escena entra:
        si no, se vería nítida, luego en mosaico y luego nítida otra vez. */}
    <script is:inline>
        (function () {
            try {
                if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                document.querySelector("[data-hero-portrait]").setAttribute("data-pending", "");
            } catch (e) {}
        })();
    </script>
</section>

<script>
    import { initHeroPortrait, destroyHeroPortrait } from "@/lib/hero-portrait";
    import { initHeroTerminal, destroyHeroTerminal } from "@/lib/hero-terminal";
    const start = () => {
        void initHeroTerminal();
        void initHeroPortrait();
    };
    start();
    document.addEventListener("astro:page-load", start);
    document.addEventListener("astro:before-swap", () => {
        destroyHeroTerminal();
        destroyHeroPortrait();
    });
</script>

<style>
    .hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        align-items: center;
        gap: var(--space-7);
        min-block-size: 100svh;
        padding: calc(var(--header-height) + var(--space-4)) var(--gutter) calc(var(--hud-height) + var(--space-4));
        overflow: hidden;
    }

    /* --- La ventana de Terminal --- */

    .hero__terminal {
        z-index: 1;
        max-inline-size: 40rem;
    }

    .term {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: var(--space-5) var(--space-5) var(--space-6);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        line-height: 1.5;
        color: var(--color-text);
    }

    .term__prompt {
        color: var(--color-live);
    }

    .term__line {
        color: var(--color-text);
    }

    .term__line:not(:first-child) {
        margin-block-start: var(--space-3);
    }

    .term__name {
        margin-block: var(--space-1);
        font-size: clamp(2.25rem, 1.3rem + 3.4vw, 4.5rem);
        line-height: 1;
        color: var(--color-accent-strong);
    }

    .term__out {
        color: var(--color-text-muted);
    }

    .term__dim {
        color: var(--color-text-subtle);
    }

    .term__now {
        color: var(--color-text);
    }

    .term__arrow {
        color: var(--mac-yellow);
    }

    .term__cursor {
        display: inline-block;
        inline-size: 0.6em;
        block-size: 1.15em;
        margin-inline-start: 0.15em;
        vertical-align: text-bottom;
        background: var(--color-text);
        animation: term-blink 1.06s steps(1) infinite;
    }

    @keyframes term-blink {
        50% {
            opacity: 0;
        }
    }

    /* Mientras escribe: los pasos que aún no tocan, escondidos pero ocupando
       su sitio, para que la ventana no crezca a saltos. Si el módulo no llega
       a ejecutarse, a los 6 s aparece todo de todas formas. */
    .hero__terminal[data-typing] [data-step]:not([data-shown]) {
        visibility: hidden;
        animation: term-fallback 0s 6s forwards;
    }

    @keyframes term-fallback {
        to {
            visibility: visible;
        }
    }

    /* --- El retrato --- */

    .hero__portrait {
        position: relative;
        align-self: stretch;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        min-block-size: 0;
    }

    /* La foto se funde con el fondo por abajo: el recorte acaba en la camiseta
       y un corte recto quedaría pegado. */
    .hero__portrait-still,
    .hero__portrait :global(.hero__portrait-canvas) {
        mask-image: linear-gradient(to top, transparent, #000 16%);
    }

    .hero__portrait-still {
        max-block-size: 100%;
        inline-size: auto;
        max-inline-size: 100%;
        object-fit: contain;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    .hero__portrait :global(.hero__portrait-canvas) {
        position: absolute;
        pointer-events: none;
    }

    /* Mientras llega la escena, la foto no se ve; si no llega, aparece sola. */
    .hero__portrait[data-pending] .hero__portrait-still {
        opacity: 0;
        animation: portrait-fallback 0s 2.5s forwards;
    }

    .hero__portrait[data-live] .hero__portrait-still {
        opacity: 0;
        animation: none;
    }

    @keyframes portrait-fallback {
        to {
            opacity: 1;
        }
    }

    /* En estrecho: la terminal arriba y el retrato debajo. */
    @media (max-width: 56rem) {
        .hero {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: auto minmax(22rem, 1fr);
            gap: var(--space-5);
        }

        .hero__terminal {
            max-inline-size: none;
        }

        .term {
            padding: var(--space-4);
            font-size: var(--text-xs);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .term__cursor {
            animation: none;
        }
    }
</style>
