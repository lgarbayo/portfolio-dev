---
import Section from "../Section.astro";
import { pressArticles } from "@/lib/press";
import { localeTags, useTranslations, type Locale } from "@/i18n/index";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const date = new Intl.DateTimeFormat(localeTags[locale], {
    day: "2-digit", month: "short", year: "numeric", timeZone: "UTC",
});
---

<Section id="press" title={t("press.title")}>
    <ul class="press" role="list">
        {pressArticles.map((article) => (
            <li data-reveal>
                <a class="press__row" href={article.url} target="_blank" rel="noopener noreferrer"
                    data-track="press_link_click" data-track-publisher={article.publisher}>
                    <time class="label" datetime={article.published}>{date.format(new Date(article.published))}</time>
                    <span class="press__publisher">{article.publisher}</span>
                    <span class="press__headline" lang={article.language}>{article.title}</span>
                    <span class="press__go label" aria-hidden="true">{t("press.readArticle")} ↗</span>
                </a>
            </li>
        ))}
    </ul>
</Section>

<style>
    .press {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .press__row {
        display: grid;
        grid-template-columns: 9rem 11rem minmax(0, 1fr) auto;
        align-items: baseline;
        gap: var(--space-2) var(--space-5);
        padding: var(--space-4) var(--space-2);
        border-block-end: 1px solid var(--color-border);
        color: var(--color-text);
        text-decoration: none;
        transition: background-color var(--duration-fast) var(--ease-out);
    }

    .press__row:hover,
    .press__row:focus-visible {
        background: var(--color-accent-dim);
        color: var(--color-accent-strong);
    }

    .press__publisher {
        font-family: var(--font-pixel);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
    }

    .press__headline {
        color: var(--color-text-muted);
    }

    .press__row:hover .press__headline {
        color: var(--color-text);
    }

    @media (max-width: 62rem) {
        .press__row {
            grid-template-columns: minmax(0, 1fr) auto;
        }

        .press__headline {
            grid-column: 1 / -1;
        }

        .press__go {
            display: none;
        }
    }
</style>
