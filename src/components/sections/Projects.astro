---
import Section from "../Section.astro";
import ProjectCard from "../ProjectCard.astro";
import { getLocalizedEntries } from "@/lib/content";
import { localeTags, useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = await getLocalizedEntries("projects", locale);

// Destacados primero, luego por año. El slug estabiliza los empates entre idiomas.
const byRank = (a: (typeof projects)[number], b: (typeof projects)[number]) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.slug.localeCompare(b.data.slug);
};

/*
 * Las actividades van aparte y al final. No son proyectos —no tienen repo, ni
 * stack, ni nada que abrir— pero cuentan de dónde viene el interés: la radio del
 * colegio, un coche de gravedad, la revista de la facultad.
 */
const activities = (await getLocalizedEntries("activities", locale)).sort(
    (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);

const period = new Intl.DateTimeFormat(localeTags[locale], { month: "short", year: "numeric" });
const formatPeriod = (start: Date, end?: Date) =>
    end ? `${period.format(start)} – ${period.format(end)}` : period.format(start);

const rankedProjects = projects.sort(byRank);
const taiafoxIndex = rankedProjects.findIndex((project) => project.data.slug === "taiafox");
const meigasearchIndex = rankedProjects.findIndex((project) => project.data.slug === "meigasearch");
if (taiafoxIndex >= 0 && meigasearchIndex >= 0) {
    [rankedProjects[taiafoxIndex], rankedProjects[meigasearchIndex]] =
        [rankedProjects[meigasearchIndex], rankedProjects[taiafoxIndex]];
}
const isApi = (project: (typeof projects)[number]) => project.data.slug.endsWith("-api");
const orderedProjects = rankedProjects.filter((project) => !isApi(project));
---

<Section id="projects" title={t("projects.title")}>
    <div class="projects__grid">
        {orderedProjects.map((project) => (
            <ProjectCard locale={locale} project={project} isFallback={project.isFallback} />
        ))}
    </div>

    {
        activities.length > 0 && (
            <div class="activities">
                <h3 class="activities__title" data-reveal>
                    {t("projects.activities.title")}
                </h3>
                <ul class="activities__list" role="list">
                    {activities.map((item) => (
                        <li class="activities__item" data-reveal>
                            <p class="activities__name">{item.data.title}</p>
                            <p class="activities__meta">
                                {item.data.context && <>{item.data.context} · </>}
                                <span class="activities__period">
                                    {formatPeriod(item.data.startDate, item.data.endDate)}
                                </span>
                            </p>
                            {item.data.description && (
                                <p class="activities__description">{item.data.description}</p>
                            )}
                            {item.data.award && (
                                <p class="activities__award">{item.data.award}</p>
                            )}
                        </li>
                    ))}
                </ul>
            </div>
        )
    }
</Section>

<style>
    .activities {
        margin-block-start: var(--space-8);
    }

    .activities__title {
        margin-block-end: var(--space-4);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
    }

    .activities__list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .activities__item {
        padding: var(--space-4);
        background: var(--color-glass-surface);
        border: 1px solid var(--color-glass-border);
        border-radius: 1.25rem;
        box-shadow: var(--shadow-glass);
        backdrop-filter: blur(16px) saturate(120%);
        -webkit-backdrop-filter: blur(16px) saturate(120%);
    }

    .activities__name {
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        color: var(--color-text);
    }

    .activities__meta {
        margin-block-start: var(--space-1);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }

    .activities__period {
        font-family: var(--font-mono);
        color: var(--color-text-subtle);
    }

    .activities__description {
        margin-block-start: var(--space-2);
        font-size: var(--text-sm);
        color: var(--color-text-muted);
    }

    .activities__award {
        margin-block-start: var(--space-2);
        font-size: var(--text-xs);
        font-style: italic;
        color: var(--color-text-subtle);
    }

    .projects__grid {
        display: grid;
        grid-template-columns: repeat(10, minmax(0, 1fr));
        gap: var(--space-5);
    }

    .projects__grid > :global(.card) {
        grid-column: span 6;
    }

    .projects__grid > :global(.card:nth-child(4n + 2)),
    .projects__grid > :global(.card:nth-child(4n + 3)) {
        grid-column: span 4;
    }

    @media (max-width: 80rem) {
        .projects__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .projects__grid > :global(.card:nth-child(n)) {
            grid-column: auto;
        }
    }

    @media (max-width: 48rem) {
        .projects__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
