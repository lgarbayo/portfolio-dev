---
import Section from "../Section.astro";
import ProjectCard from "../ProjectCard.astro";
import { getLocalizedEntries } from "@/lib/content";
import { localeTags, useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = await getLocalizedEntries("projects", locale);

// Orden dentro de cada grupo: destacados primero, luego por año descendente.
// Los proyectos sin año van al final, que es donde acaba lo que no está fechado.
const byRank = (a: (typeof projects)[number], b: (typeof projects)[number]) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return (b.data.year ?? 0) - (a.data.year ?? 0);
};

const categories = [
    { id: "hackathon", label: t("projects.category.hackathon") },
    { id: "data", label: t("projects.category.data") },
    { id: "backend", label: t("projects.category.backend") },
    { id: "web", label: t("projects.category.web") },
] as const;

/*
 * Las actividades van aparte y al final. No son proyectos —no tienen repo, ni
 * stack, ni nada que abrir— pero cuentan de dónde viene el interés: la radio del
 * colegio, un coche de gravedad, la revista de la facultad.
 */
const activities = (await getLocalizedEntries("activities", locale)).sort(
    (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);

const period = new Intl.DateTimeFormat(localeTags[locale], { month: "short", year: "numeric" });
const formatPeriod = (start: Date, end?: Date) =>
    end ? `${period.format(start)} – ${period.format(end)}` : period.format(start);

const grouped = categories
    .map((category) => ({
        ...category,
        items: projects.filter((project) => project.data.category === category.id).sort(byRank),
    }))
    .filter((group) => group.items.length > 0);
---

<Section id="projects" title={t("projects.title")}>
    {
        grouped.map((group) => (
            <div class="projects__group">
                <h3 class="projects__group-title">{group.label}</h3>
                <div class="projects__grid">
                    {group.items.map((project) => (
                        <ProjectCard
                            locale={locale}
                            project={project}
                            isFallback={project.isFallback}
                        />
                    ))}
                </div>
            </div>
        ))
    }

    {
        activities.length > 0 && (
            <div class="activities">
                <h3 class="activities__title" data-reveal>
                    {t("projects.activities.title")}
                </h3>
                <ul class="activities__list" role="list">
                    {activities.map((item) => (
                        <li class="activities__item" data-reveal>
                            <p class="activities__name">{item.data.title}</p>
                            <p class="activities__meta">
                                {item.data.context && <>{item.data.context} · </>}
                                <span class="activities__period">
                                    {formatPeriod(item.data.startDate, item.data.endDate)}
                                </span>
                            </p>
                            {item.data.description && (
                                <p class="activities__description">{item.data.description}</p>
                            )}
                            {item.data.award && (
                                <p class="activities__award">{item.data.award}</p>
                            )}
                        </li>
                    ))}
                </ul>
            </div>
        )
    }
</Section>

<style>
    .activities {
        margin-block-start: var(--space-8);
    }

    .activities__title {
        margin-block-end: var(--space-4);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
    }

    /* En columnas, y sin tarjeta: son notas al pie de la sección, no proyectos.
       Con el mismo marco que los de arriba competirían con ellos. */
    .activities__list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
        gap: var(--space-5) var(--space-6);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .activities__name {
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        color: var(--color-text);
    }

    .activities__meta {
        margin-block-start: var(--space-1);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }

    .activities__period {
        font-family: var(--font-mono);
        color: var(--color-text-subtle);
    }

    .activities__description {
        margin-block-start: var(--space-2);
        font-size: var(--text-sm);
        color: var(--color-text-muted);
    }

    .activities__award {
        margin-block-start: var(--space-2);
        font-size: var(--text-xs);
        font-style: italic;
        color: var(--color-text-subtle);
    }

    .projects__group + .projects__group {
        margin-block-start: var(--space-7);
    }

    .projects__group-title {
        font-size: var(--text-sm);
        font-family: var(--font-mono);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
        margin-block-end: var(--space-4);
    }

    .projects__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
        gap: var(--space-5);
    }

</style>
