---
import Section from "../Section.astro";
import { getCollection } from "astro:content";
import { useTranslations, type Locale } from "@/i18n/index";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const stack = await getCollection("stack");

const categories = [
    { id: "languages", label: t("stack.category.languages") },
    { id: "backend", label: t("stack.category.backend") },
    { id: "frontend", label: t("stack.category.frontend") },
    { id: "data", label: t("stack.category.data") },
    { id: "devops", label: t("stack.category.devops") },
] as const;

const grouped = categories
    .map((category) => ({
        ...category,
        items: stack
            .filter((entry) => entry.data.category === category.id)
            .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name)),
    }))
    .filter((group) => group.items.length > 0);

// Las teclas que sí llegan a la escena 3D. Se serializan al DOM para que la isla
// no tenga que volver a leer la colección en cliente.
//
// Del logo viaja aquí sólo el slug, no la ruta SVG: las quince rutas juntas son
// 10 KB gzip, y meterlas en el HTML se las cobra a todo el mundo —también a
// quien ve el sitio en el móvil, donde la escena ni se monta—. Las rutas van
// dentro del chunk perezoso del teclado (ver `scripts/keycap-icons-plugin.mjs`).
const keycaps = stack
    .filter((entry) => entry.data.keycap)
    .map((entry) => ({
        name: entry.data.name,
        keycap: entry.data.keycap,
        key: entry.data.key ?? null,
        icon: entry.data.icon ?? null,
    }));
---

<Section id="stack" title={t("stack.title")} description={t("stack.description")}>
    <!--
      Contenedor reservado para la escena interactiva (grupo 12). El listado de
      abajo NO es su respaldo: es el contenido real del stack, y existe siempre,
      renderice o no la escena. Un rastreador y un lector de pantalla tienen que
      poder leerlo sin WebGL.
    -->
    <div
        class="stack__scene"
        data-stack-scene
        data-keycaps={JSON.stringify(keycaps)}
        aria-label={t("stack.scene.label")}
        role="img"
    >
    </div>

    <div class="stack__controls">
        <!--
          Nace oculto y lo revela la isla: si la escena no monta, no aparece un
          botón de silencio para un sonido que no existe.
        -->
        <button
            class="stack__sound"
            type="button"
            hidden
            aria-pressed="false"
            data-stack-sound
            data-label-mute={t("stack.scene.mute")}
            data-label-unmute={t("stack.scene.unmute")}
        >
            {t("stack.scene.unmute")}
        </button>
        <!--
          Las teclas se hunden al pasar el ratón, y eso no se descubre solo:
          igual que la referencia, la escena lo dice. Nace oculto y lo revela la
          isla, porque sin escena no hay nada por lo que pasar el ratón.
        -->
        <p class="stack__hint" hidden data-stack-hint>{t("stack.scene.hint")}</p>
        <!-- La tecnología activada, en texto: el 3D nunca es la única fuente. -->
        <p class="stack__readout" data-stack-readout aria-live="polite"></p>
    </div>

    <div class="stack__groups">
        {
            grouped.map((group) => (
                <div class="stack__group" data-reveal>
                    <h3 class="stack__group-title">{group.label}</h3>
                    <ul class="stack__list" role="list">
                        {group.items.map((entry) => (
                            <li class="tag">{entry.data.name}</li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
</Section>

<script>
    import { initStackScene, destroyStackScene } from "@/lib/stack-scene";
    initStackScene();
    document.addEventListener("astro:page-load", () => initStackScene());
    document.addEventListener("astro:before-swap", destroyStackScene);
</script>

<style>
    .stack__scene:empty {
        /* Sin escena montada no ocupa nada: la reserva de espacio la hace la
           propia isla cuando sabe que va a pintar. */
        display: none;
    }

    /* A sangre: la placa se sale de la columna de texto y ocupa el ancho de la
       pantalla. El `50% - 50vw` compensa el centrado del contenedor. */
    .stack__scene:not(:empty) {
        inline-size: 100vw;
        margin-inline-start: calc(50% - 50vw);
    }

    .stack__scene :global(canvas) {
        inline-size: 100%;
        block-size: 100%;
        /* El cursor lo lleva la escena: `grab` sobre el vacío, `pointer` sobre
           una tecla, `grabbing` mientras se gira. */
        touch-action: none;
    }

    /*
     * `100vw` cuenta la barra de scroll y el contenido no, así que sin esto la
     * sección asoma unos píxeles por la derecha y aparece scroll horizontal en
     * toda la página. `clip` recorta sin crear un contenedor de scroll, que es
     * lo que sí haría `hidden`.
     */
    :global(#stack) {
        overflow-x: clip;
    }

    .stack__controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
        margin-block-end: var(--space-6);
        min-block-size: var(--tap-target);
    }

    .stack__controls:has(> [hidden]):not(:has(> :not([hidden]))) {
        display: none;
    }

    .stack__sound {
        min-block-size: var(--tap-target);
        padding-inline: var(--space-4);
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-full);
        color: var(--color-text-muted);
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        cursor: pointer;
    }

    .stack__sound[hidden] {
        display: none;
    }

    .stack__sound[aria-pressed="true"] {
        border-color: var(--color-accent-border);
        color: var(--color-accent);
    }

    .stack__hint {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-subtle);
    }

    .stack__hint[hidden] {
        display: none;
    }

    .stack__readout {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--color-accent);
    }

    .stack__groups {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        gap: var(--space-6);
    }

    .stack__group-title {
        font-size: var(--text-sm);
        font-family: var(--font-mono);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
        margin-block-end: var(--space-3);
    }

    .stack__list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>
