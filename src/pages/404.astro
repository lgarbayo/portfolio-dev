---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageTrail from "@/components/PageTrail.astro";
import PageLinks from "@/components/PageLinks.astro";
import { channels } from "@/lib/channels";
import { getPublishedPosts } from "@/lib/content";
import { defaultLocale, localizedPath, useTranslations } from "@/i18n/index";

/*
 * Una sola 404 para todo el sitio, en el idioma por defecto. También es la que
 * responde ante un prefijo de idioma que no existe (`/fr/…`): esas rutas no se
 * generan, así que el host sirve esta página.
 */
const locale = defaultLocale;
const t = useTranslations(locale);
const posts = await getPublishedPosts(locale);
---

<BaseLayout locale={locale} title={t("notFound.title")} description={t("notFound.description")}>
    {/* La marca que hace que la analítica pueda separar esta página del
        resto: se sirve bajo cualquier URL rota, así que su ruta no dice
        nada. Con el grupo aparte, el informe de páginas de la 404 es la
        lista de enlaces rotos que apuntan al sitio. */}
    <div class="container notfound" data-not-found>
        <PageTrail
            locale={locale}
            back={{ label: t("nav.home"), href: localizedPath(locale) }}
            crumbs={[{ label: "404" }]}
        />
        <h1>{t("notFound.title")}</h1>
        <p>{t("notFound.description")}</p>
        {/* Una 404 no tiene «atrás»: se ofrecen las tres puertas del sitio. */}
        <PageLinks
            locale={locale}
            links={[
                { href: localizedPath(locale), kicker: t("notFound.home"), title: t("nav.home"), meta: "lgarbayo.com" },
                ...(posts.length > 0
                    ? [{ href: localizedPath(locale, "blog"), kicker: t("nav.blog"), title: t("blog.all"), meta: t("blog.count", { count: posts.length }) }]
                    : []),
                { href: "/links/", kicker: t("links.title"), title: t("qr.title"), meta: t("links.count", { count: channels.length }) },
            ]}
        />
    </div>
</BaseLayout>

<style>
    .notfound {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding-block: calc(var(--header-height) + var(--space-4)) var(--space-10);
    }

    .notfound p {
        color: var(--color-text-muted);
        max-inline-size: var(--prose-width);
    }
</style>
