---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localeTags, localizedPath, otherLocales, useTranslations, type Locale } from "@/i18n/index";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    // Los borradores existen en desarrollo para poder verlos; en producción no
    // se genera su página siquiera.
    const visible = posts.filter((post) => import.meta.env.DEV || !post.data.draft);

    return visible.map((post) => ({
        params: { locale: post.data.locale, slug: post.data.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const { Content } = await render(post);

// Si el artículo existe en otro idioma el selector va a él; si no, al índice del
// blog de ese idioma. Los posts no caen a otro idioma: media traducción es peor
// que nada, así que el enlace lleva a donde sí hay algo que leer.
const all = await getCollection("posts");
const counterpartPaths = Object.fromEntries(
    otherLocales(locale).map((target) => {
        const counterpart = all.find(
            (entry) => entry.data.slug === post.data.slug && entry.data.locale === target,
        );
        return [
            target,
            counterpart
                ? localizedPath(target, `blog/${counterpart.data.slug}`)
                : localizedPath(target, "blog"),
        ];
    }),
);

const formatter = new Intl.DateTimeFormat(localeTags[locale], {
    day: "numeric",
    month: "long",
    year: "numeric",
});
---

<BaseLayout
    locale={locale}
    title={`${post.data.title} — ${t("site.title")}`}
    description={post.data.description}
    image={post.data.cover}
    canonicalOverride={post.data.canonicalUrl}
    type="article"
    counterpartPaths={counterpartPaths}
    showBlog
>
    <article class="container post">
        <header class="post__head">
            <p class="post__meta">
                <time datetime={post.data.pubDate.toISOString()}>
                    {formatter.format(post.data.pubDate)}
                </time>
                {post.data.draft && <span class="post__draft">{t("blog.draft")}</span>}
            </p>
            <h1>{post.data.title}</h1>
            <p class="post__description">{post.data.description}</p>

            {
                post.data.tags.length > 0 && (
                    <ul class="post__tags" role="list">
                        {post.data.tags.map((tag) => (
                            <li>
                                <a class="tag" href={localizedPath(locale, `blog/tag/${tag}`)}>
                                    {tag}
                                </a>
                            </li>
                        ))}
                    </ul>
                )
            }
        </header>

        {
            post.data.cover && (
                <img
                    class="post__cover"
                    src={post.data.cover}
                    alt={post.data.coverAlt!}
                    width="1200"
                    height="630"
                    loading="lazy"
                    decoding="async"
                />
            )
        }

        <div class="post__body prose">
            <Content />
        </div>

        <a class="post__back" href={localizedPath(locale, "blog")}>← {t("blog.backToIndex")}</a>
    </article>
</BaseLayout>

<style>
    .post {
        padding-block: var(--space-8) var(--section-gap);
    }

    .post__head {
        max-inline-size: var(--prose-width);
        margin-block-end: var(--space-6);
    }

    .post__meta {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-text-subtle);
        margin-block-end: var(--space-3);
    }

    .post__draft {
        padding: var(--space-1) var(--space-2);
        border: 1px dashed var(--color-border-strong);
        border-radius: var(--radius-sm);
    }

    .post__description {
        margin-block-start: var(--space-4);
        font-size: var(--text-lg);
        color: var(--color-text-muted);
    }

    .post__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-block-start: var(--space-4);
        padding: 0;
        list-style: none;
    }

    .post__tags a {
        text-decoration: none;
    }

    .post__cover {
        inline-size: 100%;
        block-size: auto;
        border-radius: var(--radius-md);
        margin-block-end: var(--space-6);
    }

    .post__body {
        color: var(--color-text-muted);
        line-height: var(--leading-relaxed);
    }

    .post__body :global(h2),
    .post__body :global(h3) {
        margin-block: var(--space-6) var(--space-3);
        color: var(--color-text);
    }

    .post__body :global(p),
    .post__body :global(ul),
    .post__body :global(ol) {
        margin-block-end: var(--space-4);
    }

    /* Las figuras del cuerpo traen su propio pie; el margen por defecto del
       navegador (40px a los lados) las desalinearía del texto. */
    .post__body :global(figure) {
        margin: var(--space-6) 0;
    }

    .post__body :global(figcaption) {
        margin-block-start: var(--space-3);
        font-size: var(--text-sm);
        color: var(--color-text-subtle);
    }

    .post__body :global(pre) {
        overflow-x: auto;
        overscroll-behavior-x: contain;
        padding: var(--space-4);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        margin-block-end: var(--space-4);
    }

    .post__body :global(blockquote) {
        margin-block-end: var(--space-4);
        padding-inline-start: var(--space-4);
        border-inline-start: 3px solid var(--color-accent);
        color: var(--color-text-subtle);
    }

    .post__back {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--tap-target);
        margin-block-start: var(--space-7);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
    }
</style>
