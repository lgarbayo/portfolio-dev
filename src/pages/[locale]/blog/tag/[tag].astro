---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import PageTrail from "@/components/PageTrail.astro";
import PageLinks from "@/components/PageLinks.astro";
import { getPublishedPosts } from "@/lib/content";
import { locales, localizedPath, useTranslations, type Locale } from "@/i18n/index";

export async function getStaticPaths() {
    const paths = [];

    // Las etiquetas se recorren por idioma: cada uno lista sólo sus artículos,
    // así que una etiqueta puede existir en inglés y no en español.
    for (const locale of locales) {
        const posts = await getPublishedPosts(locale);
        const tags = new Set(posts.flatMap((post) => post.data.tags));

        for (const tag of tags) {
            paths.push({
                params: { locale, tag },
                props: { posts: posts.filter((post) => post.data.tags.includes(tag)), tag },
            });
        }
    }

    return paths;
}

const { posts, tag } = Astro.props;
const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const title = t("blog.tag.title", { tag });
const blogPath = localizedPath(locale, "blog");
const total = (await getPublishedPosts(locale)).length;
---

<BaseLayout locale={locale} title={`${title} — ${t("site.title")}`} description={title} showBlog>
    <div class="container tagpage">
        <PageTrail
            locale={locale}
            back={{ label: t("blog.all"), href: blogPath }}
            crumbs={[{ label: "blog", href: blogPath }, { label: "tag" }, { label: tag }]}
        />
        <h1>{title}</h1>
        <PostList locale={locale} posts={posts} emptyMessage={t("blog.empty")} />
        <PageLinks
            locale={locale}
            links={[
                { href: blogPath, kicker: t("pageLinks.back"), title: t("blog.all"), meta: t("blog.count", { count: total }), direction: "back" },
                { href: localizedPath(locale), kicker: t("pageLinks.more"), title: t("nav.home"), meta: "lgarbayo.com" },
            ]}
        />
    </div>
</BaseLayout>

<style>
    .tagpage {
        padding-block: calc(var(--header-height) + var(--space-4)) var(--section-gap);
    }

    .tagpage h1 {
        font-size: var(--text-2xl);
        margin-block-end: var(--space-6);
    }

</style>
