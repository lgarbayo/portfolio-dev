---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { channels, isExternal } from "@/lib/channels";
import { publicAssetExists } from "@/lib/assets";
import { getPublishedPosts } from "@/lib/content";
import { defaultLocale, locales, localizedPath, useTranslations } from "@/i18n/index";

/*
 * La página a la que lleva el QR de la cabecera.
 *
 * Sin prefijo de idioma a propósito, y es la única del sitio que se salta el
 * esquema. La URL de esta página se dice en voz alta y se teclea a mano —"entra
 * en lgarbayo.com/links"—, y `/es/links/` es una sílaba de más y una decisión
 * que quien la escucha no tiene por qué tomar. Lo que hay dentro tampoco la
 * necesita: son cuatro nombres de plataforma que no se traducen.
 *
 * Los enlaces salen de `lib/channels`, los mismos que la sección de Contacto.
 * La diferencia entre las dos no es qué enseñan sino cuándo: Contacto se lee
 * sentado, dentro del recorrido de la página, y esto se abre de pie con el
 * móvil recién escaneado.
 */
const locale = defaultLocale;
const t = useTranslations(locale);
const posts = await getPublishedPosts(locale);

// Retrato propio de esta página, no el de la sección Sobre mí: allí va una foto
// y aquí un avatar, que aguanta mejor el recorte redondo y el tamaño pequeño.
const PORTRAIT = "/assets/ui/avatar-pixel.png";
const portrait = publicAssetExists(PORTRAIT) ? PORTRAIT : null;

/*
 * El selector de idioma de la cabecera traduce la ruta por segmentos, y aquí eso
 * apunta a `/es/links/`, que no existe. Se le dan los destinos a mano —es para
 * lo que está `counterpartPaths`—: quien pulse otro idioma se va a la portada en
 * ese idioma, que es lo que quería.
 */
const counterpartPaths = Object.fromEntries(
    locales.map((code) => [code, localizedPath(code)]),
);
---

<BaseLayout
    locale={locale}
    title={t("links.title")}
    description={t("links.description")}
    counterpartPaths={counterpartPaths}
    alternateLocales={[locale]}
    showBlog={posts.length > 0}
>
    {/* Una ventana de macOS con la lista agrupada de Ajustes del Sistema:
        icono, nombre y la flecha. Una fila por canal, a todo lo ancho, que se
        pulsa con el pulgar. */}
    <section class="links">
        <div class="links__window mac-window">
            <div class="mac-titlebar">
                <span class="mac-lights" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="mac-title">lgarbayo — links</span>
            </div>

            <div class="links__body">
                {
                    portrait && (
                        <img
                            class="links__portrait"
                            src={portrait}
                            alt={t("links.portraitAlt")}
                            width="88"
                            height="88"
                            fetchpriority="high"
                        />
                    )
                }

                <h1 class="links__title">{t("site.title")}</h1>

                <ul class="links__list" role="list">
                    {
                        channels.map((channel) => (
                            <li>
                                <a
                                    class="links__link"
                                    href={channel.href}
                                    aria-label={t(channel.label)}
                                    data-track="channel_click"
                                    data-track-channel-name={channel.name}
                                    data-track-channel-surface="links"
                                    {...isExternal(channel.href)
                                        ? { target: "_blank", rel: "noopener noreferrer" }
                                        : {}}
                                >
                                    <span class="links__badge" aria-hidden="true">
                                        <span class="links__icon" style={`--icon: url(${channel.icon})`} />
                                    </span>
                                    <span class="links__name">{channel.name}</span>
                                    <span class="links__chevron" aria-hidden="true">›</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <ul class="links__list" role="list">
                    <li>
                        <a
                            class="links__link"
                            href={localizedPath(locale)}
                            data-track="channel_click"
                            data-track-channel-name="Portfolio"
                            data-track-channel-surface="links"
                        >
                            <span class="links__badge links__badge--site" aria-hidden="true">~</span>
                            <span class="links__name">{t("links.portfolio")}</span>
                            <span class="links__chevron" aria-hidden="true">›</span>
                        </a>
                    </li>
                    {posts.length > 0 && (
                        <li>
                            <a
                                class="links__link"
                                href={localizedPath(locale, "blog")}
                                data-track="channel_click"
                                data-track-channel-name="Blog"
                                data-track-channel-surface="links"
                            >
                                <span class="links__badge links__badge--blog" aria-hidden="true">✎</span>
                                <span class="links__name">{t("nav.blog")}</span>
                                <span class="links__count">{t("blog.count", { count: posts.length })}</span>
                                <span class="links__chevron" aria-hidden="true">›</span>
                            </a>
                        </li>
                    )}
                </ul>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* Una columna estrecha y centrada: esto se abre en un móvil recién
       escaneado, y ahí una lista a lo ancho no aporta nada. */
    .links {
        display: grid;
        place-items: center;
        inline-size: min(100% - var(--gutter) * 2, 26rem);
        margin-inline: auto;
        padding-block: calc(var(--header-height) + var(--space-4)) calc(var(--hud-height) + var(--space-6));
    }

    .links__window {
        inline-size: 100%;
    }

    .links__body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-6) var(--space-4) var(--space-5);
        text-align: center;
    }

    .links__portrait {
        inline-size: 5.5rem;
        block-size: 5.5rem;
        border-radius: var(--radius-full);
        object-fit: cover;
        box-shadow: 0 0 0 0.5px var(--mac-border), 0 8px 24px rgba(0, 0, 0, 0.5);
    }

    .links__title {
        font-size: var(--text-xl);
        color: var(--color-accent-strong);
    }

    /* La lista agrupada: un bloque redondeado con separadores finos que no
       llegan al borde izquierdo, empiezan donde empieza el texto. */
    .links__list {
        inline-size: 100%;
        margin: 0;
        padding: 0;
        list-style: none;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        overflow: hidden;
    }

    .links__list li + li .links__link::before {
        content: "";
        position: absolute;
        inset-block-start: 0;
        inset-inline: 3.1rem 0;
        border-block-start: 0.5px solid rgba(255, 255, 255, 0.12);
    }

    .links__link {
        position: relative;
        display: flex;
        align-items: center;
        gap: var(--space-3);
        min-block-size: calc(var(--tap-target) + var(--space-1));
        padding-inline: 0.65rem 0.9rem;
        color: var(--color-text);
        text-decoration: none;
        font-family: var(--font-system);
        font-size: 0.9375rem;
        text-align: start;
        transition: background-color var(--duration-fast) var(--ease-out);
    }

    .links__link:hover,
    .links__link:focus-visible {
        background: rgba(255, 255, 255, 0.08);
    }

    /* El icono en su cuadradito redondeado, como los de Ajustes. */
    .links__badge {
        display: grid;
        place-items: center;
        flex: none;
        inline-size: 1.75rem;
        block-size: 1.75rem;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 7px;
        color: #fff;
        font-family: var(--font-mono);
        font-weight: 700;
    }

    .links__badge--site {
        background: var(--mac-blue);
    }

    .links__badge--blog {
        background: #ff9f0a;
    }

    .links__name {
        flex: 1;
    }

    .links__count {
        font-size: 0.8125rem;
        color: var(--color-text-subtle);
    }

    .links__chevron {
        font-size: 1.25rem;
        line-height: 1;
        color: var(--color-text-subtle);
    }

    /* El icono es una máscara sobre el color del texto, no una imagen suelta. */
    .links__icon {
        inline-size: 1rem;
        block-size: 1rem;
        background-color: currentColor;
        -webkit-mask: var(--icon) center / contain no-repeat;
        mask: var(--icon) center / contain no-repeat;
    }
</style>
